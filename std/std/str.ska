from std::error import panic;
import std::str::parse_f64 as parse_f64;

public class Str {
    private _storage: shared u8[];
    private _start: i64;
    private _length: u64;

    init() {
        self._storage = new u8[]();
        self._start = 0;
        self._length = 0u;
    }

    private init(storage: shared u8[], start: i64, length: u64) {
        self._storage = storage;
        self._start = start;
        self._length = length;
    }

    fn len() -> u64 {
        return self._length;
    }

    fn byte(index: i64) -> u8 {
        var normalized_index: i64 = index;
        if (normalized_index < 0) {
            normalized_index = (i64) self._length + normalized_index;
        }

        if (normalized_index < 0 || (u64) normalized_index >= self._length) {
            panic("array index out of bounds");
        }

        return self._storage->[self._start + normalized_index];
    }

    fn equals(ref other: Obj) -> bool {
        if (!(other is Str)) {
            return false;
        }
        return self._equals_str((Str) other);
    }

    fn slice(start: i64, end: i64) -> Str {
        var normalized_start: i64 = start;
        if (normalized_start < 0) {
            normalized_start = normalized_start + (i64) self._length;
        }

        var normalized_end: i64 = end;
        if (normalized_end < 0) {
            normalized_end = normalized_end + (i64) self._length;
        }

        if (normalized_start < 0 || normalized_end < normalized_start || (u64) normalized_end > self._length) {
            panic("array index out of bounds");
        }

        return Str(self._storage, self._start + normalized_start, (u64) (normalized_end - normalized_start));
    }

    static fn from_bytes(ref bytes: u8[]) -> Str {
        return Str(new u8[](copy bytes), 0, bytes.len());
    }

    static fn from_bool(value: bool) -> Str {
        if (value) {
            return "true";
        }
        return "false";
    }

    static fn from_i64(value: i64) -> Str {
        var negative: bool = value < 0;
        var magnitude: u64 = (u64) value;
        if (negative) {
            // The total cast preserves the two's-complement bits. Wrapping
            // subtraction therefore forms the magnitude without negating
            // i64 minimum.
            magnitude = 0u - magnitude;
        }
        return Str._from_decimal_magnitude(magnitude, negative);
    }

    static fn from_u64(value: u64) -> Str {
        return Str._from_decimal_magnitude(value, false);
    }

    static fn from_u8(value: u8) -> Str {
        return Str._from_decimal_magnitude((u64) value, false);
    }

    fn to_bool() -> bool? {
        if (
            self._length == 4u
            && self.byte(0) == 116u8
            && self.byte(1) == 114u8
            && self.byte(2) == 117u8
            && self.byte(3) == 101u8
        ) {
            return true;
        }
        if (
            self._length == 5u
            && self.byte(0) == 102u8
            && self.byte(1) == 97u8
            && self.byte(2) == 108u8
            && self.byte(3) == 115u8
            && self.byte(4) == 101u8
        ) {
            return false;
        }
        return none;
    }

    fn to_i64() -> i64? {
        if (self._length == 0u) {
            return none;
        }

        var negative: bool = false;
        var start: u64 = 0u;
        var limit: u64 = 9223372036854775807u;
        if (self.byte(0) == 45u8) {
            negative = true;
            start = 1u;
            limit = 9223372036854775808u;
        }

        var parsed: u64? = self._parse_decimal_magnitude(start, limit);
        if (parsed is none) {
            return none;
        }

        var magnitude: u64 = parsed!;
        if (negative) {
            if (magnitude == 9223372036854775808u) {
                return -9223372036854775808;
            }
            return -((i64) magnitude);
        }
        return (i64) magnitude;
    }

    fn to_u64() -> u64? {
        return self._parse_decimal_magnitude(0u, 18446744073709551615u);
    }

    fn to_u8() -> u8? {
        var parsed: u64? = self._parse_decimal_magnitude(0u, 255u);
        if (parsed is none) {
            return none;
        }
        return (u8) parsed!;
    }

    fn to_f64() -> f64? {
        var nan: Str = "NaN";
        if (self.equals(nan)) {
            return 0.0 / 0.0;
        }
        var infinity: Str = "Infinity";
        if (self.equals(infinity)) {
            return 1.0 / 0.0;
        }
        var negative_infinity: Str = "-Infinity";
        if (self.equals(negative_infinity)) {
            return -(1.0 / 0.0);
        }
        return parse_f64::parse(*self._storage, self._start, self._length);
    }

    private fn _equals_str(ref other: Str) -> bool {
        if (self._length != other._length) {
            return false;
        }

        var self_storage: shared u8[] = self._storage;
        var other_storage: shared u8[] = other._storage;
        var index: u64 = 0u;
        while (index < self._length) {
            var offset: i64 = (i64) index;
            if (
                self_storage->[self._start + offset]
                != other_storage->[other._start + offset]
            ) {
                return false;
            }
            index = index + 1u;
        }
        return true;
    }

    private static fn _decimal_digit_count(value: u64) -> u64 {
        var remaining: u64 = value;
        var count: u64 = 1u;
        while (remaining >= 10u) {
            remaining = remaining / 10u;
            count = count + 1u;
        }
        return count;
    }

    private static fn _from_decimal_magnitude(
        magnitude: u64,
        negative: bool
    ) -> Str {
        var digit_count: u64 = Str._decimal_digit_count(magnitude);
        var sign_length: u64 = 0u;
        if (negative) {
            sign_length = 1u;
        }

        var text_length: u64 = sign_length + digit_count;
        var storage: shared u8[] = new u8[](text_length);
        var remaining: u64 = magnitude;
        var index: i64 = (i64) text_length - 1;

        while (digit_count > 0u) {
            storage->[index] = (u8) (remaining % 10u + 48u);
            remaining = remaining / 10u;
            digit_count = digit_count - 1u;
            index = index - 1;
        }

        if (negative) {
            storage->[0] = 45u8;
        }
        return Str(storage, 0, text_length);
    }

    private fn _parse_decimal_magnitude(
        start: u64,
        limit: u64
    ) -> u64? {
        if (start >= self._length) {
            return none;
        }

        var limit_quotient: u64 = limit / 10u;
        var limit_remainder: u64 = limit % 10u;
        var value: u64 = 0u;
        var index: u64 = start;
        while (index < self._length) {
            var byte_value: u8 = self.byte((i64) index);
            if (byte_value < 48u8 || byte_value > 57u8) {
                return none;
            }

            var digit: u64 = (u64) (byte_value - 48u8);
            if (
                value > limit_quotient
                || (value == limit_quotient && digit > limit_remainder)
            ) {
                return none;
            }

            value = value * 10u + digit;
            index = index + 1u;
        }
        return value;
    }

    fn to_bytes() -> u8[] {
        return self._storage->[self._start:(self._start + (i64) self._length)];
    }

    fn concat(ref other: Str) -> Str {
        var combined_length: u64 = self._length + other._length;
        var result: shared u8[] = new u8[](combined_length);

        var middle: i64 = (i64) self._length;
        result->[:middle] = self._storage->[self._start:(self._start + (i64) self._length)];
        result->[middle:] = other._storage->[other._start:(other._start + (i64) other._length)];

        return Str(result, 0, combined_length);
    }
}
