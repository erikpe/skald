from std::error import panic;
from std::vec import Vec;
import std::str::format_integer as format_integer;
import std::str::format_f64 as format_f64;
import std::str::parse_integer as parse_integer;
import std::str::parse_f64 as parse_f64;

public class Str {
    private static _EMPTY_STORAGE: shared u8[] = new u8[]();

    private _storage: shared u8[];
    private _start: i64;
    private _length: u64;

    init() {
        self._storage = Str._EMPTY_STORAGE;
        self._start = 0;
        self._length = 0u;
    }

    private init(storage: shared u8[], start: i64, length: u64) {
        self._storage = storage;
        self._start = start;
        self._length = length;
    }

    fn len() -> u64 {
        return self._length;
    }

    fn index_get(index: i64) -> u8 {
        var normalized_index: i64 = index;
        if (normalized_index < 0) {
            normalized_index = (i64) self._length + normalized_index;
        }
        if (normalized_index < 0 || (u64) normalized_index >= self._length) {
            panic("Str.index_get: index out of bounds");
        }
        return self._storage->[self._start + normalized_index];
    }

    fn slice_get(start: i64?, end: i64?) -> Str {
        var normalized_start: i64 = 0;
        if (start is some) {
            normalized_start = start!;
        }
        if (normalized_start < 0) {
            normalized_start = normalized_start + (i64) self._length;
        }
        var normalized_end: i64 = (i64) self._length;
        if (end is some) {
            normalized_end = end!;
        }
        if (normalized_end < 0) {
            normalized_end = normalized_end + (i64) self._length;
        }
        if (normalized_start < 0 || normalized_end < normalized_start || (u64) normalized_end > self._length) {
            panic("Str.slice_get: index out of bounds");
        }
        return Str(self._storage, self._start + normalized_start, (u64) (normalized_end - normalized_start));
    }

    fn splitlines() -> Vec<Str> {
        var lines: Vec<Str> = Vec<Str>();
        var length: i64 = (i64) self._length;
        var start: i64 = 0;
        var cursor: i64 = 0;

        while (cursor < length) {
            var byte: u8 = self._storage->[self._start + cursor];
            if (byte == '\n') {
                lines.push(self[start:cursor]);
                cursor = cursor + 1;
                start = cursor;
                continue;
            }
            if (byte == '\r') {
                lines.push(self[start:cursor]);
                if (cursor + 1 < length && self._storage->[self._start + cursor + 1] == '\n') {
                    cursor = cursor + 2;
                }
                else {
                    cursor = cursor + 1;
                }
                start = cursor;
                continue;
            }
            cursor = cursor + 1;
        }
        if (start < length) {
            lines.push(self[start:length]);
        }
        return lines;
    }

    fn split(ref delimiter: Str) -> Vec<Str> {
        if (delimiter._length == 0u) {
            panic("Str.split: empty delimiter");
        }

        var parts: Vec<Str> = Vec<Str>();
        var length: i64 = (i64) self._length;
        var delimiter_length: i64 = (i64) delimiter._length;
        var start: i64 = 0;
        var cursor: i64 = 0;

        while (cursor <= length - delimiter_length) {
            var delimiter_cursor: i64 = 0;
            var matches: bool = true;
            while (delimiter_cursor < delimiter_length) {
                if (self._storage->[self._start + cursor + delimiter_cursor]
                    != delimiter._storage->[delimiter._start + delimiter_cursor]) {
                    matches = false;
                    break;
                }
                delimiter_cursor = delimiter_cursor + 1;
            }
            if (matches) {
                parts.push(self[start:cursor]);
                cursor = cursor + delimiter_length;
                start = cursor;
            }
            else {
                cursor = cursor + 1;
            }
        }
        parts.push(self[start:length]);
        return parts;
    }

    fn join(ref values: Vec<Str>) -> Str {
        var value_count: u64 = values.len();
        if (value_count == 0u) {
            return Str();
        }
        var total_length: u64 = 0u;
        var index: u64 = 0u;
        while (index < value_count) {
            total_length = total_length + values[(i64) index]._length;
            index = index + 1u;
        }
        total_length = total_length + (value_count - 1u) * self._length;

        var separator_start: i64 = self._start;
        var separator_end: i64 = separator_start + (i64) self._length;
        var separator_length: i64 = separator_end - separator_start;

        var result: shared u8[] = new u8[](total_length);
        var offset: i64 = 0;
        index = 0u;
        while (index < value_count) {
            if (index > 0u) {
                result->[offset:offset + separator_length] = self._storage->[separator_start:separator_end];
                offset = offset + separator_length;
            }
            var value: Str = values[(i64) index];
            var value_start: i64 = value._start;
            var value_length: i64 = (i64) value._length;
            result->[offset:offset + value_length] = value._storage->[value_start:value_start + value_length];
            offset = offset + value_length;
            index = index + 1u;
        }
        return Str(result, 0, total_length);
    }

    fn equals(ref other: Obj) -> bool {
        if (!(other is Str)) {
            return false;
        }
        return self.equals_str((Str) other);
    }

    fn equals_str(ref other: Str) -> bool {
        if (self._length != other._length) {
            return false;
        }

        var self_storage: shared u8[] = self._storage;
        var other_storage: shared u8[] = other._storage;
        var index: u64 = 0u;
        while (index < self._length) {
            var offset: i64 = (i64) index;
            if (self_storage->[self._start + offset] != other_storage->[other._start + offset]) {
                return false;
            }
            index = index + 1u;
        }
        return true;
    }

    fn concat(ref other: Str) -> Str {
        var combined_length: u64 = self._length + other._length;
        var result: shared u8[] = new u8[](combined_length);

        var middle: i64 = (i64) self._length;
        result->[:middle] = self._storage->[self._start:(self._start + (i64) self._length)];
        result->[middle:] = other._storage->[other._start:(other._start + (i64) other._length)];

        return Str(result, 0, combined_length);
    }

    static fn from_bytes(ref bytes: u8[]) -> Str {
        return Str(new u8[](copy bytes), 0, bytes.len());
    }

    static fn from_bool(value: bool) -> Str {
        if (value) {
            return "true";
        }
        return "false";
    }

    static fn from_i64(value: i64) -> Str {
        var storage: shared u8[] = format_integer::format_i64(value);
        return Str(storage, 0, storage->len());
    }

    static fn from_u64(value: u64) -> Str {
        var storage: shared u8[] = format_integer::format_u64(value);
        return Str(storage, 0, storage->len());
    }

    static fn from_u8(value: u8) -> Str {
        var storage: shared u8[] = format_integer::format_u8(value);
        return Str(storage, 0, storage->len());
    }

    static fn from_f64(value: f64) -> Str {
        if (value != value) {
            return "NaN";
        }
        var infinity: f64 = 1.0 / 0.0;
        if (value == infinity) {
            return "Infinity";
        }
        if (value == -infinity) {
            return "-Infinity";
        }
        var storage: shared u8[] = format_f64::format(value);
        return Str(storage, 0, storage->len());
    }

    fn to_bytes() -> u8[] {
        return self._storage->[self._start:(self._start + (i64) self._length)];
    }

    fn to_bool() -> bool? {
        if (self._length == "true"._length && self.equals_str("true")) {
            return true;
        }
        if (self._length == "false"._length && self.equals_str("false")) {
            return false;
        }
        return none;
    }

    fn to_i64() -> i64? {
        return parse_integer::parse_i64(*self._storage, self._start, self._length);
    }

    fn to_u64() -> u64? {
        return parse_integer::parse_u64(*self._storage, self._start, self._length);
    }

    fn to_u8() -> u8? {
        return parse_integer::parse_u8(*self._storage, self._start, self._length);
    }

    fn to_f64() -> f64? {
        if (self.equals_str("NaN")) {
            return 0.0 / 0.0;
        }
        if (self.equals_str("Infinity")) {
            return 1.0 / 0.0;
        }
        if (self.equals_str("-Infinity")) {
            return -(1.0 / 0.0);
        }
        return parse_f64::parse(*self._storage, self._start, self._length);
    }
}
