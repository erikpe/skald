public class Str {
    private _storage: shared u8[];
    private _start: u64;
    private _length: u64;

    init() {
        self._storage = new u8[]();
        self._start = 0u;
        self._length = 0u;
    }

    private init(storage: shared u8[], start: u64, length: u64) {
        self._storage = storage;
        self._start = start;
        self._length = length;
    }

    fn len() -> u64 {
        return self._length;
    }

    fn byte(index: u64) -> u8 {
        if (index < self._length) {
            return self._storage->[(i64) (self._start + index)];
        }
        Str._fail_bounds_check();
        return 0u8;
    }

    fn slice(start: u64, length: u64) -> Str {
        if (start <= self._length) {
            if (length <= self._length - start) {
                return Str(self._storage, self._start + start, length);
            }
        }
        Str._fail_bounds_check();
        return Str();
    }

    static fn from_bytes(ref bytes: u8[]) -> Str {
        return Str(new u8[](copy bytes), 0u, bytes.len());
    }

    fn to_bytes() -> u8[] {
        var result: u8[] = u8[](self._length);
        var source_start: i64 = (i64) self._start;
        var source_end: i64 = (i64) (self._start + self._length);
        result[:] = self._storage->[source_start:source_end];
        return result;
    }

    fn concat(ref other: Str) -> Str {
        var combined_length: u64 = self._length + other._length;
        var result: shared u8[] = new u8[](combined_length);
        var middle: i64 = (i64) self._length;
        var end: i64 = (i64) combined_length;
        var self_start: i64 = (i64) self._start;
        var self_end: i64 = (i64) (self._start + self._length);
        var other_start: i64 = (i64) other._start;
        var other_end: i64 = (i64) (other._start + other._length);
        result->[:middle] = self._storage->[self_start:self_end];
        result->[middle:end] = other._storage->[other_start:other_end];
        return Str(result, 0u, combined_length);
    }

    private static fn _fail_bounds_check() -> unit {
        var empty: u8[] = u8[]();
        var ignored: u8 = empty[0];
        return;
    }
}
