from std::hash import mix_u64;
from std::lang import Equatable, Hashable;

public class BoxU8 implements Equatable, Hashable {
    final value: u8;

    init(value: u8) {
        self.value = value;
    }

    fn equals(ref other: Obj) -> bool {
        if (!(other is BoxU8)) {
            return false;
        }
        return self.value == ((BoxU8) other).value;
    }

    fn hash_code() -> u64 {
        return mix_u64(((u64) self.value) ^ 0x75385f5f626f7801u);
    }
}
