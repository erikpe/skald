from std::hash import mix_u64;
from std::lang import Equatable, Hashable;

public class BoxU64 implements Equatable, Hashable {
    final value: u64;

    init(value: u64) {
        self.value = value;
    }

    fn equals(ref other: Obj) -> bool {
        if (!(other is BoxU64)) {
            return false;
        }
        return self.value == ((BoxU64) other).value;
    }

    fn hash_code() -> u64 {
        return mix_u64(self.value ^ 0x7536345f626f7801u);
    }
}
