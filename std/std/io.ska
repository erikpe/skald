import std::str;
from std::error import panic;

intrinsic fn _io_standard_handle(stream: u8) -> i64;
intrinsic fn _io_open(ref path: u8[], mode: u8) -> i64;
intrinsic fn _io_read(handle: i64, mut ref destination: u8[], offset: u64) -> i64;
intrinsic fn _io_write(handle: i64, ref source: u8[], offset: u64) -> i64;
intrinsic fn _io_close(handle: i64) -> i64;

fn _next_read_capacity(capacity: u64) -> u64 {
    if (capacity == 0u || capacity > 4611686018427387903u) {
        panic("io: input too large");
    }
    return capacity * 2u;
}

fn _read_all(handle: i64, source: u8) -> u8[] {
    var bytes: u8[] = u8[](64u);
    var filled: u64 = 0u;

    while (true) {
        if (filled == bytes.len()) {
            var capacity: u64 = bytes.len();
            var grown: u8[] = u8[](_next_read_capacity(capacity));
            grown[:(i64) capacity] = bytes;
            bytes = grown;
        }

        var result: i64 = _io_read(handle, bytes, filled);
        if (result < 0) {
            if (source == 0u8) {
                panic("io: failed to read stdin");
            }
            panic("io: failed to read file");
        }
        if (result == 0) {
            return bytes[:(i64) filled];
        }

        var count: u64 = (u64) result;
        var remaining: u64 = bytes.len() - filled;
        if (count > remaining) {
            panic("io: invalid runtime result");
        }
        filled = filled + count;
    }
    return u8[]();
}

fn _write_all(ref bytes: u8[], stream: u8) -> unit {
    var handle: i64 = _io_standard_handle(stream);
    var offset: u64 = 0u;

    while (offset < bytes.len()) {
        var result: i64 = _io_write(handle, bytes, offset);
        if (result < 0) {
            if (stream == 1u8) {
                panic("io: failed to write stdout");
            }
            panic("io: failed to write stderr");
        }

        var written: u64 = (u64) result;
        var remaining: u64 = bytes.len() - offset;
        if (written == 0u || written > remaining) {
            panic("io: invalid runtime result");
        }
        offset = offset + written;
    }
    return;
}

public fn read_stdin() -> std::str::Str {
    var handle: i64 = _io_standard_handle(0u8);
    var bytes: u8[] = _read_all(handle, 0u8);
    return std::str::Str.from_bytes(bytes);
}

public fn read_file(ref path: std::str::Str) -> std::str::Str {
    var path_bytes: u8[] = path.to_bytes();
    var handle: i64 = _io_open(path_bytes, 0u8);
    if (handle < 0) {
        panic("io: failed to open file");
    }

    var bytes: u8[] = _read_all(handle, 1u8);
    var close_result: i64 = _io_close(handle);
    if (close_result < 0) {
        panic("io: failed to close file");
    }
    return std::str::Str.from_bytes(bytes);
}

public fn write_stdout(ref text: std::str::Str) -> unit {
    var bytes: u8[] = text.to_bytes();
    if (bytes.len() == 0u) {
        return;
    }
    _write_all(bytes, 1u8);
    return;
}

public fn write_stderr(ref text: std::str::Str) -> unit {
    var bytes: u8[] = text.to_bytes();
    if (bytes.len() == 0u) {
        return;
    }
    _write_all(bytes, 2u8);
    return;
}

fn _write_stdout_line(ref text: std::str::Str) -> unit {
    var newline: std::str::Str = "\n";
    write_stdout(text);
    write_stdout(newline);
    return;
}

public fn println_bool(value: bool) -> unit {
    var text: std::str::Str = std::str::Str.from_bool(value);
    _write_stdout_line(text);
    return;
}

public fn println_i64(value: i64) -> unit {
    var text: std::str::Str = std::str::Str.from_i64(value);
    _write_stdout_line(text);
    return;
}

public fn println_u64(value: u64) -> unit {
    var text: std::str::Str = std::str::Str.from_u64(value);
    _write_stdout_line(text);
    return;
}

public fn println_u8(value: u8) -> unit {
    var text: std::str::Str = std::str::Str.from_u8(value);
    _write_stdout_line(text);
    return;
}

public fn println_f64(value: f64) -> unit {
    var text: std::str::Str = std::str::Str.from_f64(value);
    _write_stdout_line(text);
    return;
}
