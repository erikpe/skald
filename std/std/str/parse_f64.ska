import std::f64;

// The fixed-width common path follows Eisel-Lemire decimal conversion as used
// by Rust's core decimal parser. The independent static powers below are
// generated from the same mathematical power-of-five definitions.
// Source revision: rust-lang/rust 8bab26f4f68e0e26f0bb7960be334d5b520ea452
// See std/THIRD_PARTY.md for provenance.

public fn parse(ref storage: u8[], start: i64, length: u64) -> f64? {
    if (!_is_valid_range(storage, start, length)) {
        return none;
    }

    return _parse_decimal_f64(storage, start, length);
}

fn _is_valid_range(ref storage: u8[], start: i64, length: u64) -> bool {
    if (start < 0) {
        return false;
    }

    var storage_length: u64 = storage.len();
    var unsigned_start: u64 = (u64) start;
    if (unsigned_start > storage_length) {
        return false;
    }
    return length <= storage_length - unsigned_start;
}

fn _parse_decimal_f64(
    ref storage: u8[],
    start: i64,
    length: u64
) -> f64? {
    if (length == 0u) {
        return none;
    }

    var negative: bool = false;
    var index: u64 = 0u;
    if (storage[start] == '-') {
        negative = true;
        index = 1u;
    }
    if (index == length) {
        return none;
    }

    var saw_digit: bool = false;
    var saw_nonzero: bool = false;
    var saw_point: bool = false;
    var digit_index: u64 = 0u;
    var digits_before_point: u64 = 0u;
    var first_nonzero_index: u64 = 0u;
    var small_significand: u64 = 0u;
    var small_digit_count: u64 = 0u;
    var small_significand_complete: bool = true;

    while (index < length) {
        var byte_value: u8 = storage[start + (i64) index];
        if (byte_value >= '0' && byte_value <= '9') {
            saw_digit = true;
            if (!saw_point) {
                digits_before_point = digits_before_point + 1u;
            }

            var digit: u64 = (u64) (byte_value - '0');
            if (!saw_nonzero && digit != 0u) {
                saw_nonzero = true;
                first_nonzero_index = digit_index;
            }
            if (saw_nonzero && small_significand_complete) {
                if (small_digit_count < 19u) {
                    // Every 19-digit decimal is below u64 maximum, so the
                    // multiply-add cannot wrap while this guard holds.
                    small_significand = small_significand * 10u + digit;
                    small_digit_count = small_digit_count + 1u;
                } else {
                    small_significand_complete = false;
                }
            }

            digit_index = digit_index + 1u;
            index = index + 1u;
            continue;
        }
        if (byte_value == '.' && !saw_point) {
            saw_point = true;
            index = index + 1u;
            continue;
        }
        break;
    }

    if (!saw_digit) {
        return none;
    }

    var exponent_negative: bool = false;
    var exponent_magnitude: u64 = 0u;
    if (index < length) {
        var exponent_marker: u8 = storage[start + (i64) index];
        if (exponent_marker != 'e' && exponent_marker != 'E') {
            return none;
        }
        index = index + 1u;
        if (index == length) {
            return none;
        }

        var exponent_sign: u8 = storage[start + (i64) index];
        if (exponent_sign == '+' || exponent_sign == '-') {
            exponent_negative = exponent_sign == '-';
            index = index + 1u;
        }
        if (index == length) {
            return none;
        }

        var exponent_cap: u64 = length;
        if (exponent_cap <= 18446744073709547519u) {
            exponent_cap = exponent_cap + 4096u;
        } else {
            exponent_cap = 18446744073709551615u;
        }
        var cap_quotient: u64 = exponent_cap / 10u;
        var cap_remainder: u64 = exponent_cap % 10u;
        for (exponent_index in index .. length) {
            var exponent_byte: u8 = storage[start + (i64) exponent_index];
            if (exponent_byte < '0' || exponent_byte > '9') {
                return none;
            }

            var exponent_digit: u64 = (u64) (exponent_byte - '0');
            if (exponent_magnitude < exponent_cap) {
                if (
                    exponent_magnitude > cap_quotient
                    || (
                        exponent_magnitude == cap_quotient
                        && exponent_digit > cap_remainder
                    )
                ) {
                    exponent_magnitude = exponent_cap;
                } else {
                    exponent_magnitude = exponent_magnitude * 10u + exponent_digit;
                }
            }
        }
    }

    if (!saw_nonzero) {
        if (negative) {
            return -0.0;
        }
        return 0.0;
    }

    var position_negative: bool = false;
    var position_magnitude: u64 = 0u;
    if (digits_before_point > first_nonzero_index) {
        position_magnitude = digits_before_point - first_nonzero_index - 1u;
    } else {
        position_negative = true;
        var distance: u64 = first_nonzero_index - digits_before_point;
        if (distance == 18446744073709551615u) {
            position_magnitude = distance;
        } else {
            position_magnitude = distance + 1u;
        }
    }

    var decimal_exponent: i64 = _bounded_signed_sum(
        position_negative,
        position_magnitude,
        exponent_negative,
        exponent_magnitude
    );
    if (decimal_exponent > 308) {
        return none;
    }
    if (decimal_exponent < -324) {
        if (negative) {
            return -0.0;
        }
        return 0.0;
    }

    var significand_exponent: i64 = (
        decimal_exponent - ((i64) small_digit_count - 1)
    );
    if (small_significand_complete) {
        var fast_value: f64? = _try_small_decimal_f64(
            small_significand,
            significand_exponent,
            negative
        );
        if (!(fast_value is none)) {
            return fast_value!;
        }
    }

    var eisel_lemire_value: f64? = _try_eisel_lemire_f64(
        small_significand,
        significand_exponent,
        !small_significand_complete,
        negative
    );
    if (!(eisel_lemire_value is none)) {
        return eisel_lemire_value!;
    }
    return _parse_decimal_f64_exact(
        storage,
        start,
        length,
        decimal_exponent,
        negative
    );
}

fn _try_eisel_lemire_f64(
    significand: u64,
    decimal_exponent: i64,
    truncated: bool,
    negative: bool
) -> f64? {
    var rounded: _BiasedF64 = _compute_eisel_lemire(
        significand,
        decimal_exponent
    );
    if (!rounded.available) {
        return none;
    }

    // The discarded decimal tail lies within these adjacent prefix endpoints.
    // It is safe to skip the exact fallback only when both round to the same
    // binary64 representation.
    if (truncated) {
        var upper: _BiasedF64 = _compute_eisel_lemire(
            significand + 1u,
            decimal_exponent
        );
        if (
            !upper.available
            || upper.mantissa != rounded.mantissa
            || upper.biased_exponent != rounded.biased_exponent
        ) {
            return none;
        }
    }

    // A finite decimal that rounds to infinity is outside the frozen parser
    // range and therefore remains an optional failure.
    if (rounded.biased_exponent == 0x7ff) {
        return none;
    }

    var bits: u64 = (
        rounded.mantissa
        | ((u64) rounded.biased_exponent << 52u)
    );
    if (negative) {
        bits = bits | 0x8000000000000000u;
    }
    return std::f64::from_bits(bits);
}

fn _compute_eisel_lemire(
    significand: u64,
    decimal_exponent: i64
) -> _BiasedF64 {
    if (significand == 0u || decimal_exponent < -342) {
        return _BiasedF64(0u, 0);
    }
    if (decimal_exponent > 308) {
        return _BiasedF64(0u, 0x7ff);
    }

    var leading_zeroes: u64 = _leading_zeroes(significand);
    var normalized: u64 = significand << leading_zeroes;
    var product: _WideProduct = _compute_product_approx(
        decimal_exponent,
        normalized
    );

    if (
        product.low == 0xffffffffffffffffu
        && (decimal_exponent < -27 || decimal_exponent > 55)
    ) {
        return _BiasedF64();
    }

    var upper_bit: u64 = product.high >> 63u;
    var mantissa_shift: u64 = upper_bit + 9u;
    var mantissa: u64 = product.high >> mantissa_shift;
    var biased_exponent: i64 = (
        _eisel_power(decimal_exponent)
        + (i64) upper_bit
        - (i64) leading_zeroes
        + 1023
    );

    if (biased_exponent <= 0) {
        var subnormal_shift: i64 = -biased_exponent + 1;
        if (subnormal_shift >= 64) {
            return _BiasedF64(0u, 0);
        }
        mantissa = mantissa >> (u64) subnormal_shift;
        mantissa = mantissa + (mantissa & 0x1u);
        mantissa = mantissa >> 1u;
        var subnormal_exponent: i64 = 0;
        if (mantissa >= 0x0010000000000000u) {
            subnormal_exponent = 1;
        }
        return _BiasedF64(mantissa, subnormal_exponent);
    }

    if (
        product.low <= 1u
        && decimal_exponent >= -4
        && decimal_exponent <= 23
        && (mantissa & 0x3u) == 0x1u
        && (mantissa << mantissa_shift) == product.high
    ) {
        mantissa = mantissa & 0xfffffffffffffffeu;
    }

    mantissa = mantissa + (mantissa & 0x1u);
    mantissa = mantissa >> 1u;
    if (mantissa >= 0x0020000000000000u) {
        mantissa = 0x0010000000000000u;
        biased_exponent = biased_exponent + 1;
    }
    mantissa = mantissa & 0x000fffffffffffffu;
    if (biased_exponent >= 0x7ff) {
        return _BiasedF64(0u, 0x7ff);
    }
    return _BiasedF64(mantissa, biased_exponent);
}

fn _compute_product_approx(
    decimal_exponent: i64,
    significand: u64
) -> _WideProduct {
    var power: _WideProduct = _EiselPowers.get(decimal_exponent);
    var first: _WideProduct = _multiply_wide(significand, power.low);

    // With 56 requested precision bits, an all-one low suffix can carry into
    // the rounding decision. One more high product supplies the required
    // 192-bit approximation without a general wide integer.
    if ((first.high & 0xffu) == 0xffu) {
        var second_high: u64 = _multiply_high(significand, power.high);
        var previous_low: u64 = first.low;
        first.low = first.low + second_high;
        if (first.low < previous_low) {
            first.high = first.high + 1u;
        }
    }
    return first;
}

fn _multiply_wide(left: u64, right: u64) -> _WideProduct {
    return _WideProduct(left * right, _multiply_high(left, right));
}

fn _multiply_high(left: u64, right: u64) -> u64 {
    var mask: u64 = 0xffffffffu;
    var left_low: u64 = left & mask;
    var left_high: u64 = left >> 32u;
    var right_low: u64 = right & mask;
    var right_high: u64 = right >> 32u;

    var low_low: u64 = left_low * right_low;
    var low_high: u64 = left_low * right_high;
    var high_low: u64 = left_high * right_low;
    var high_high: u64 = left_high * right_high;
    var middle1: u64 = high_low + (low_low >> 32u);
    var middle2: u64 = low_high + (middle1 & mask);
    return high_high + (middle1 >> 32u) + (middle2 >> 32u);
}

fn _leading_zeroes(value: u64) -> u64 {
    var remaining: u64 = value;
    var result: u64 = 0u;
    while ((remaining & 0x8000000000000000u) == 0u) {
        remaining = remaining << 1u;
        result = result + 1u;
    }
    return result;
}

fn _eisel_power(decimal_exponent: i64) -> i64 {
    var scaled: i64 = decimal_exponent * 217706;
    if (scaled < 0) {
        return -((-scaled + 65535) / 65536) + 63;
    }
    return scaled / 65536 + 63;
}

