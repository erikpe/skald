        var inverse_offsets: Str = "\x54\x45\x54\x54\x45\x55\x05\x04\x00\x10\x04\x10\x14\x04\x40\x00\x00\x00\x01\x40\x55\x55\x15\x41\x54\x04\x00\x00\x44\x00\x01\x00\x00\x00\x00\x40\x41\x00\x00\x44\x50\x44\x45\x50\x54\x00\x55\x55\x54\x55\x65\x51\x00\x40\x00\x40\x01\x00\x00\x01\x00\x05\x01\x00\x11\x54\x51\x51\x54\x55\x55\x05\x00\x15\x41\x50\x00\x00\x04\x40\x10\x01\x04\x05\x00\x00\x00\x00";
