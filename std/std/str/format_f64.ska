import std::f64;

// The finite conversion algorithm and cached powers are derived from Ryū:
// Copyright 2018 Ulf Adams, Apache-2.0 or BSL-1.0.
// Source revision: https://github.com/ulfjack/ryu/tree/4c0618b0e44f7ef027ebae05d2cc7812048f7c8f
// See std/THIRD_PARTY.md for details.

// `value` must be finite. `Str.from_f64` owns NaN and infinity spelling.
public fn format(value: f64) -> shared u8[] {
    var bits: u64 = std::f64::to_bits(value);
    var negative: bool = (bits >> 63u) != 0u;
    var ieee_mantissa: u64 = bits & 0x000fffffffffffffu;
    var ieee_exponent: u64 = (bits >> 52u) & 0x7ffu;

    if (ieee_exponent == 0u && ieee_mantissa == 0u) {
        return _zero(negative);
    }

    var decimal: _RyuDecimal = _small_integer(
        ieee_mantissa,
        ieee_exponent
    );
    if (!decimal.available) {
        decimal = _to_shortest_decimal(ieee_mantissa, ieee_exponent);
    }

    var digit_count: u64 = _decimal_digit_count(decimal.mantissa);
    var scientific_exponent: i64 = (
        decimal.exponent + (i64) digit_count - 1
    );
    return _render(
        decimal.mantissa,
        digit_count,
        scientific_exponent,
        negative
    );
}

fn _small_integer(
    ieee_mantissa: u64,
    ieee_exponent: u64
) -> _RyuDecimal {
    if (ieee_exponent == 0u) {
        return _RyuDecimal();
    }

    var binary_exponent: i64 = (i64) ieee_exponent - 1023 - 52;
    if (binary_exponent > 0 || binary_exponent < -52) {
        return _RyuDecimal();
    }

    var mantissa: u64 = 0x0010000000000000u | ieee_mantissa;
    var shift: u64 = (u64) (-binary_exponent);
    var mask: u64 = (0x1u << shift) - 0x1u;
    if ((mantissa & mask) != 0u) {
        return _RyuDecimal();
    }

    var decimal_mantissa: u64 = mantissa >> shift;
    var decimal_exponent: i64 = 0;
    while (decimal_mantissa % 10u == 0u) {
        decimal_mantissa = decimal_mantissa / 10u;
        decimal_exponent = decimal_exponent + 1;
    }
    return _RyuDecimal(decimal_mantissa, decimal_exponent);
}

fn _to_shortest_decimal(
    ieee_mantissa: u64,
    ieee_exponent: u64
) -> _RyuDecimal {
    var binary_exponent: i64 = 0;
    var binary_mantissa: u64 = 0u;
    if (ieee_exponent == 0u) {
        binary_exponent = -1076;
        binary_mantissa = ieee_mantissa;
    } else {
        binary_exponent = (i64) ieee_exponent - 1077;
        binary_mantissa = 0x0010000000000000u | ieee_mantissa;
    }

    var accept_bounds: bool = binary_mantissa % 2u == 0u;
    var interval_value: u64 = 4u * binary_mantissa;
    var lower_shift: u64 = 0u;
    if (ieee_mantissa != 0u || ieee_exponent <= 1u) {
        lower_shift = 1u;
    }

    var value: u64 = 0u;
    var upper: u64 = 0u;
    var lower: u64 = 0u;
    var decimal_exponent: i64 = 0;
    var lower_trailing_zeroes: bool = false;
    var value_trailing_zeroes: bool = false;

    if (binary_exponent >= 0) {
        var q: u64 = _log10_pow2(binary_exponent);
        if (binary_exponent > 3) {
            q = q - 1u;
        }
        decimal_exponent = (i64) q;
        var shift: i64 = (
            -binary_exponent + (i64) q + _pow5_bits(q) + 124
        );
        var power: _RyuPower = _RyuTables.inverse_power(q);
        value = _mul_shift(interval_value, power, shift);
        upper = _mul_shift(interval_value + 2u, power, shift);
        lower = _mul_shift(
            interval_value - 1u - lower_shift,
            power,
            shift
        );

        if (q <= 21u) {
            if (interval_value % 5u == 0u) {
                value_trailing_zeroes = _multiple_of_power5(
                    interval_value,
                    q
                );
            } elif (accept_bounds) {
                lower_trailing_zeroes = _multiple_of_power5(
                    interval_value - 1u - lower_shift,
                    q
                );
            } elif (_multiple_of_power5(interval_value + 2u, q)) {
                upper = upper - 1u;
            }
        }
    } else {
        var magnitude: i64 = -binary_exponent;
        var q: u64 = _log10_pow5(magnitude);
        if (magnitude > 1) {
            q = q - 1u;
        }
        decimal_exponent = (i64) q + binary_exponent;
        var power_index: u64 = (u64) magnitude - q;
        var shift: i64 = (i64) q - _pow5_bits(power_index) + 125;
        var power: _RyuPower = _RyuTables.power(power_index);
        value = _mul_shift(interval_value, power, shift);
        upper = _mul_shift(interval_value + 2u, power, shift);
        lower = _mul_shift(
            interval_value - 1u - lower_shift,
            power,
            shift
        );

        if (q <= 1u) {
            value_trailing_zeroes = true;
            if (accept_bounds) {
                lower_trailing_zeroes = lower_shift == 1u;
            } else {
                upper = upper - 1u;
            }
        } elif (q < 63u) {
            value_trailing_zeroes = _multiple_of_power2(interval_value, q);
        }
    }

    var removed: i64 = 0;
    var last_removed_digit: u64 = 0u;
    var output: u64 = 0u;
    if (lower_trailing_zeroes || value_trailing_zeroes) {
        while (upper / 10u > lower / 10u) {
            var lower_remainder: u64 = lower % 10u;
            lower_trailing_zeroes = (
                lower_trailing_zeroes && lower_remainder == 0u
            );
            value_trailing_zeroes = (
                value_trailing_zeroes && last_removed_digit == 0u
            );
            last_removed_digit = value % 10u;
            value = value / 10u;
            upper = upper / 10u;
            lower = lower / 10u;
            removed = removed + 1;
        }
        if (lower_trailing_zeroes) {
            while (lower % 10u == 0u) {
                value_trailing_zeroes = (
                    value_trailing_zeroes && last_removed_digit == 0u
                );
                last_removed_digit = value % 10u;
                value = value / 10u;
                upper = upper / 10u;
                lower = lower / 10u;
                removed = removed + 1;
            }
        }
        if (
            value_trailing_zeroes
            && last_removed_digit == 5u
            && value % 2u == 0u
        ) {
            last_removed_digit = 4u;
        }
        var round_up: bool = (
            value == lower && (!accept_bounds || !lower_trailing_zeroes)
        ) || last_removed_digit >= 5u;
        output = value;
        if (round_up) {
            output = output + 1u;
        }
    } else {
        var round_up: bool = false;
        var upper_div100: u64 = upper / 100u;
        var lower_div100: u64 = lower / 100u;
        if (upper_div100 > lower_div100) {
            round_up = value % 100u >= 50u;
            value = value / 100u;
            upper = upper_div100;
            lower = lower_div100;
            removed = removed + 2;
        }
        while (upper / 10u > lower / 10u) {
            round_up = value % 10u >= 5u;
            value = value / 10u;
            upper = upper / 10u;
            lower = lower / 10u;
            removed = removed + 1;
        }
        output = value;
        if (value == lower || round_up) {
            output = output + 1u;
        }
    }
    return _RyuDecimal(output, decimal_exponent + removed);
}

fn _mul_shift(mantissa: u64, ref power: _RyuPower, shift: i64) -> u64 {
    var low_product: u64 = mantissa * power.high;
    var high_product: u64 = _multiply_high(mantissa, power.high);
    var lower_high: u64 = _multiply_high(mantissa, power.low);
    var sum: u64 = lower_high + low_product;
    if (sum < lower_high) {
        high_product = high_product + 1u;
    }
    return _shift_right_128(sum, high_product, (u64) (shift - 64));
}

fn _multiply_high(left: u64, right: u64) -> u64 {
    var mask: u64 = 0xffffffffu;
    var left_low: u64 = left & mask;
    var left_high: u64 = left >> 32u;
    var right_low: u64 = right & mask;
    var right_high: u64 = right >> 32u;

    var low_low: u64 = left_low * right_low;
    var low_high: u64 = left_low * right_high;
    var high_low: u64 = left_high * right_low;
    var high_high: u64 = left_high * right_high;
    var middle1: u64 = high_low + (low_low >> 32u);
    var middle2: u64 = low_high + (middle1 & mask);
    return high_high + (middle1 >> 32u) + (middle2 >> 32u);
}

fn _shift_right_128(low: u64, high: u64, distance: u64) -> u64 {
    return (high << (64u - distance)) | (low >> distance);
}

fn _pow5_bits(exponent: u64) -> i64 {
    return (i64) ((exponent * 1217359u) >> 19u) + 1;
}

fn _log10_pow2(exponent: i64) -> u64 {
    return ((u64) exponent * 78913u) >> 18u;
}

fn _log10_pow5(exponent: i64) -> u64 {
    return ((u64) exponent * 732923u) >> 20u;
}

fn _multiple_of_power5(value: u64, exponent: u64) -> bool {
    var remaining: u64 = value;
    var power: u64 = exponent;
    while (power > 0u) {
        if (remaining % 5u != 0u) {
            return false;
        }
        remaining = remaining / 5u;
        power = power - 1u;
    }
    return true;
}

fn _multiple_of_power2(value: u64, exponent: u64) -> bool {
    return (value & ((0x1u << exponent) - 0x1u)) == 0u;
}

fn _render(
    significand: u64,
    digit_count: u64,
    decimal_exponent: i64,
    negative: bool
) -> shared u8[] {
    if (decimal_exponent >= -3 && decimal_exponent < 7) {
        return _render_plain(
            significand,
            digit_count,
            decimal_exponent,
            negative
        );
    }
    return _render_scientific(
        significand,
        digit_count,
        decimal_exponent,
        negative
    );
}

fn _render_plain(
    significand: u64,
    digit_count: u64,
    decimal_exponent: i64,
    negative: bool
) -> shared u8[] {
    var sign_length: u64 = 0u;
    if (negative) {
        sign_length = 1u;
    }

    if (decimal_exponent < 0) {
        var leading_zeroes: u64 = (u64) (-decimal_exponent - 1);
        var result: shared u8[] = new u8[](
            sign_length + 2u + leading_zeroes + digit_count
        );
        var output: u64 = _write_sign(*result, negative);
        result->[(i64) output] = '0';
        result->[(i64) (output + 1u)] = '.';
        output = output + 2u;
        var zero: u64 = 0u;
        while (zero < leading_zeroes) {
            result->[(i64) output] = '0';
            output = output + 1u;
            zero = zero + 1u;
        }
        _write_digits(*result, output, significand, digit_count);
        return result;
    }

    var integer_digits: u64 = (u64) decimal_exponent + 1u;
    if (digit_count <= integer_digits) {
        var trailing_zeroes: u64 = integer_digits - digit_count;
        var result: shared u8[] = new u8[](
            sign_length + integer_digits + 2u
        );
        var output: u64 = _write_sign(*result, negative);
        _write_digits(*result, output, significand, digit_count);
        output = output + digit_count;
        var zero: u64 = 0u;
        while (zero < trailing_zeroes) {
            result->[(i64) output] = '0';
            output = output + 1u;
            zero = zero + 1u;
        }
        result->[(i64) output] = '.';
        result->[(i64) (output + 1u)] = '0';
        return result;
    }

    var result: shared u8[] = new u8[](
        sign_length + digit_count + 1u
    );
    var output: u64 = _write_sign(*result, negative);
    _write_digits_with_point(
        *result,
        output,
        significand,
        digit_count,
        integer_digits
    );
    return result;
}

fn _render_scientific(
    significand: u64,
    digit_count: u64,
    decimal_exponent: i64,
    negative: bool
) -> shared u8[] {
    var exponent_negative: bool = decimal_exponent < 0;
    var exponent_magnitude: u64 = (u64) decimal_exponent;
    if (exponent_negative) {
        exponent_magnitude = 0u - exponent_magnitude;
    }
    var exponent_digits: u64 = _decimal_digit_count(exponent_magnitude);
    var fractional_digits: u64 = digit_count - 1u;
    if (fractional_digits == 0u) {
        fractional_digits = 1u;
    }
    var sign_length: u64 = 0u;
    if (negative) {
        sign_length = 1u;
    }
    var exponent_sign_length: u64 = 0u;
    if (exponent_negative) {
        exponent_sign_length = 1u;
    }

    var result: shared u8[] = new u8[](
        sign_length + 3u + fractional_digits
        + exponent_sign_length + exponent_digits
    );
    var output: u64 = _write_sign(*result, negative);
    if (digit_count == 1u) {
        result->[(i64) output] = (u8) (significand + (u64) '0');
        result->[(i64) (output + 1u)] = '.';
        result->[(i64) (output + 2u)] = '0';
        output = output + 3u;
    } else {
        _write_digits_with_point(
            *result,
            output,
            significand,
            digit_count,
            1u
        );
        output = output + digit_count + 1u;
    }
    result->[(i64) output] = 'E';
    output = output + 1u;
    if (exponent_negative) {
        result->[(i64) output] = '-';
        output = output + 1u;
    }
    _write_digits(
        *result,
        output,
        exponent_magnitude,
        exponent_digits
    );
    return result;
}

fn _write_sign(mut ref destination: u8[], negative: bool) -> u64 {
    if (negative) {
        destination[0] = '-';
        return 1u;
    }
    return 0u;
}

fn _write_digits(
    mut ref destination: u8[],
    start: u64,
    value: u64,
    digit_count: u64
) -> unit {
    var divisor: u64 = _power10(digit_count - 1u);
    var remaining: u64 = value;
    var index: u64 = 0u;
    while (divisor > 0u) {
        destination[(i64) (start + index)] = (
            (u8) (remaining / divisor + (u64) '0')
        );
        remaining = remaining % divisor;
        divisor = divisor / 10u;
        index = index + 1u;
    }
}

fn _write_digits_with_point(
    mut ref destination: u8[],
    start: u64,
    value: u64,
    digit_count: u64,
    point_after: u64
) -> unit {
    var divisor: u64 = _power10(digit_count - 1u);
    var remaining: u64 = value;
    var digit: u64 = 0u;
    var output: u64 = start;
    while (divisor > 0u) {
        destination[(i64) output] = (
            (u8) (remaining / divisor + (u64) '0')
        );
        remaining = remaining % divisor;
        divisor = divisor / 10u;
        digit = digit + 1u;
        output = output + 1u;
        if (digit == point_after) {
            destination[(i64) output] = '.';
            output = output + 1u;
        }
    }
}

fn _decimal_digit_count(value: u64) -> u64 {
    var count: u64 = 1u;
    var remaining: u64 = value;
    while (remaining >= 10u) {
        remaining = remaining / 10u;
        count = count + 1u;
    }
    return count;
}

fn _power10(exponent: u64) -> u64 {
    var result: u64 = 1u;
    var remaining: u64 = exponent;
    while (remaining > 0u) {
        result = result * 10u;
        remaining = remaining - 1u;
    }
    return result;
}

fn _zero(negative: bool) -> shared u8[] {
    var length: u64 = 3u;
    if (negative) {
        length = 4u;
    }
    var result: shared u8[] = new u8[](length);
    var start: i64 = 0;
    if (negative) {
        result->[0] = '-';
        start = 1;
    }
    result->[start] = '0';
    result->[start + 1] = '.';
    result->[start + 2] = '0';
    return result;
}

class _RyuDecimal {
    mantissa: u64;
    exponent: i64;
    available: bool;

    init() {
        self.mantissa = 0u;
        self.exponent = 0;
        self.available = false;
    }

    init(mantissa: u64, exponent: i64) {
        self.mantissa = mantissa;
        self.exponent = exponent;
        self.available = true;
    }
}

class _RyuPower {
    low: u64;
    high: u64;

    init(low: u64, high: u64) {
        self.low = low;
        self.high = high;
    }
}

class _RyuTables {
    private static _inverse_powers: u64[] = u64[]{
        0x0000000000000001u, 0x2000000000000000u, 0x52a6c95fc0655034u, 0x18c240c4aecb13bbu,
        0x7ca8d50071dfc806u, 0x1327fc58da0f6ff5u, 0x6520247d3556476eu, 0x1da48ce468e7c702u,
        0x6139cdd76802e6e9u, 0x16ef5b40c2fc7779u, 0xf951a7ff43de8c79u, 0x11bebdf578b2f391u,
        0x7be8bee8d6e957e8u, 0x1b758d848fac54b0u, 0x8bd3f9e999a423eau, 0x153eda614071a3b7u,
        0x0848f973cb3ee3ceu, 0x10701bd527b4978cu, 0x153285ebb9efbfa2u, 0x196fbb9bb44db44du,
        0xadeee7f86c07b696u, 0x13ae3591f5b4d936u, 0x4d686a4eaf182222u, 0x1e74404f3daada91u,
        0x98c0a106e09ebd9fu, 0x17900ea4fda7c257u, 0x8f20e37371497d0eu, 0x123b140576d820b2u,
        0xb043138134743d85u, 0x1c35f4275f7a29adu
    };

    private static _inverse_offsets: u64[] = u64[]{
        0x0405554554544554u, 0x0040041410041000u, 0x4115555540010000u, 0x0001004400000454u,
        0x4400004140000000u, 0x5555005450454450u, 0x4000400051655554u, 0x0001050001000001u,
        0x0555555451515411u, 0x4004000050411500u, 0x0000000005040110u
    };

    private static _powers: u64[] = u64[]{
        0x0000000000000000u, 0x1000000000000000u, 0x0000000000000000u, 0x14adf4b7320334b9u,
        0x0e549208b31adb10u, 0x1aba4714957d300du, 0x6dc6ad264d8f0866u, 0x1145b7e285bf98f5u,
        0xeb1dbd923d8596cau, 0x1652efdc6018a1fcu, 0xb4c1b80b22ae923cu, 0x1cda62055b2d9d83u,
        0x5bb28b4e8f7e4c30u, 0x12a5568b9f52f416u, 0xf08aed437682d4fbu, 0x1819651531f9e78fu,
        0xb4ee134ad99bf150u, 0x1f25c186a6f04c28u, 0x16499ecb70c25f03u, 0x1420eb449c8842e6u,
        0x85a56ead360865b0u, 0x1a03fde214caf085u, 0x093db1d57999890bu, 0x10cfeb353a97dad8u,
        0xcf38bb735e3f36acu, 0x15baaf44fa52673eu
    };

    private static _offsets: u64[] = u64[]{
        0x0000000000000000u, 0x0000000000000000u, 0x5969599540000000u, 0x5655551555545555u,
        0x4055541041150504u, 0x4450454044555145u, 0x4000400045555550u, 0x5556556596440440u,
        0x4015415154454045u, 0x5140555555559155u, 0x0000000000000105u
    };

    private static _small_powers: u64[] = u64[]{
        0x0000000000000001u, 0x0000000000000005u, 0x0000000000000019u, 0x000000000000007du,
        0x0000000000000271u, 0x0000000000000c35u, 0x0000000000003d09u, 0x000000000001312du,
        0x000000000005f5e1u, 0x00000000001dcd65u, 0x00000000009502f9u, 0x0000000002e90eddu,
        0x000000000e8d4a51u, 0x0000000048c27395u, 0x000000016bcc41e9u, 0x000000071afd498du,
        0x0000002386f26fc1u, 0x000000b1a2bc2ec5u, 0x000003782dace9d9u, 0x00001158e460913du,
        0x000056bc75e2d631u, 0x0001b1ae4d6e2ef5u, 0x000878678326eac9u, 0x002a5a058fc295edu,
        0x00d3c21bcecceda1u, 0x0422ca8b0a00a425u
    };

    init() {}

    static fn power(index: u64) -> _RyuPower {
        var base: u64 = index / 26u;
        var base_index: u64 = base * 26u;
        var offset: u64 = index - base_index;
        var word: u64 = base * 2u;
        var low: u64 = _RyuTables._powers[(i64) word];
        var high: u64 = _RyuTables._powers[(i64) (word + 1u)];
        if (offset == 0u) {
            return _RyuPower(low, high);
        }

        var multiplier: u64 = _RyuTables._small_powers[(i64) offset];
        var high1: u64 = _multiply_high(multiplier, high);
        var low1: u64 = multiplier * high;
        var high0: u64 = _multiply_high(multiplier, low);
        var low0: u64 = multiplier * low;
        var sum: u64 = high0 + low1;
        if (sum < high0) {
            high1 = high1 + 1u;
        }
        var distance: u64 = (u64) (
            _pow5_bits(index) - _pow5_bits(base_index)
        );
        var correction: u64 = _RyuTables._packed_offset(
            _RyuTables._offsets,
            index
        );
        return _RyuPower(
            _shift_right_128(low0, sum, distance) + correction,
            _shift_right_128(sum, high1, distance)
        );
    }

    static fn inverse_power(index: u64) -> _RyuPower {
        var base: u64 = (index + 25u) / 26u;
        var base_index: u64 = base * 26u;
        var offset: u64 = base_index - index;
        var word: u64 = base * 2u;
        var low: u64 = _RyuTables._inverse_powers[(i64) word];
        var high: u64 = _RyuTables._inverse_powers[(i64) (word + 1u)];
        if (offset == 0u) {
            return _RyuPower(low, high);
        }

        var multiplier: u64 = _RyuTables._small_powers[(i64) offset];
        var high1: u64 = _multiply_high(multiplier, high);
        var low1: u64 = multiplier * high;
        var high0: u64 = _multiply_high(multiplier, low - 1u);
        var low0: u64 = multiplier * (low - 1u);
        var sum: u64 = high0 + low1;
        if (sum < high0) {
            high1 = high1 + 1u;
        }
        var distance: u64 = (u64) (
            _pow5_bits(base_index) - _pow5_bits(index)
        );
        var correction: u64 = _RyuTables._packed_offset(
            _RyuTables._inverse_offsets,
            index
        );
        return _RyuPower(
            _shift_right_128(low0, sum, distance) + 1u + correction,
            _shift_right_128(sum, high1, distance)
        );
    }

    private static fn _packed_offset(ref offsets: u64[], index: u64) -> u64 {
        var packed: u64 = offsets[(i64) (index / 32u)];
        var shift: u64 = (index % 32u) * 2u;
        return (packed >> shift) & 0x3u;
    }
}
