import std::io;

interface Readable {
    fn read() -> i64;
}

class Message implements Readable {
    value: i64;

    init(value: i64) {
        self.value = value;
    }

    virtual fn read() -> i64 {
        return self.value;
    }
}

class Decorated extends Message {
    extra: i64;

    init(value: i64, extra: i64) {
        super(value);
        self.extra = extra;
    }

    override fn read() -> i64 {
        return self.value + self.extra;
    }
}

fn print_readable(ref value: Readable) -> unit {
    std::io::println_i64(value.read());
}

fn inspect(ref value: Obj) -> unit {
    if (value is Decorated) {
        std::io::println_i64(((Decorated) value).read());
    }
}

fn main() -> i64 {
    var value: Decorated = Decorated(40, 2);
    print_readable(value);
    inspect(value);
    return 0;
}
