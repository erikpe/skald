import std::io;

from std::str import Str;


fn main() -> i64 {
    var greeting: Str = "hello";
    var tail: Str = greeting[1:5];

    var punctuation: u8[] = u8[](1u);
    punctuation[0] = 33u8;
    var frozen_punctuation: Str = Str.from_bytes(punctuation);
    var message: Str = greeting.concat(frozen_punctuation);

    var independent: u8[] = tail.to_bytes();
    independent[0] = 65u8;

    std::io::println_u64(message.len());
    std::io::println_u8(message[5]);
    std::io::println_u8(tail[0]);
    std::io::println_u8(independent[0]);
    return 0;
}
