import std::io;

class Value {
    number: i64;

    init(number: i64) {
        self.number = number;
    }

    copy(ref other: Value) {
        self.number = 100 + other.number;
    }

    assign(ref other: Value) {
        self.number = 200 + other.number;
    }

    destroy {
        std::io::println_i64(300 + self.number);
    }
}

fn produce(number: i64) -> Value {
    return Value(number);
}

fn observe(value: Value) -> unit {
    std::io::println_i64(value.number);
}

fn main() -> i64 {
    var direct: Value = Value(1);
    var copied: Value = direct;
    var grouped: Value = (Value(2));

    direct = produce(3);
    observe(Value(4));

    std::io::println_i64(direct.number);
    std::io::println_i64(copied.number);
    std::io::println_i64(grouped.number);
    return 0;
}
