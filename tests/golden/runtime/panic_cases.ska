import std::process;
from std::error import panic;
from std::str import Str;

fn main() -> i64 {
    var args: Str[] = std::process::args();
    if (args[1].equals("dynamic-slice")) {
        var message: Str = "prefix dynamic failure suffix";
        panic(message[7:-7]);
    }
    if (args[1].equals("empty")) {
        panic("");
    }
    panic("literal failure");
}
