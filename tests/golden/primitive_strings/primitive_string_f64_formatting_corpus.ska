import std::io as io;
from std::str import Str;
from std::test import assert_true;


fn write_line(text: Str) -> unit {
    var newline: Str = "\n";
    io::write_stdout(text);
    io::write_stdout(newline);
}

fn observe(line: Str) -> unit {
    var parsed: f64? = line.to_f64();
    assert_true(parsed is some);
    var formatted: Str = Str.from_f64(parsed!);
    write_line(formatted);

    var round_trip: f64? = formatted.to_f64();
    assert_true(round_trip is some);
    io::println_f64(round_trip!);
}

fn main() -> i64 {
    var corpus: Str = io::read_stdin();
    var start: u64 = 0u;
    var index: u64 = 0u;
    while (index < corpus.len()) {
        if (corpus.byte((i64) index) == '\n') {
            observe(corpus.slice((i64) start, (i64) index));
            start = index + 1u;
        }
        index = index + 1u;
    }
    if (start < corpus.len()) {
        observe(corpus.slice((i64) start, (i64) corpus.len()));
    }
    return 0;
}
