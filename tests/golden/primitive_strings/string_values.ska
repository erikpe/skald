import std::io;

from std::str import Str;


class Other {
    init() {}
}

fn observe(value: Str) -> unit {
    std::io::println_u64(value.len());
    std::io::println_u8(value.byte(0));
    return;
}

fn concatenated_byte(left: Str, right: Str, index: i64) -> u8 {
    var combined: Str = left.concat(right);
    return combined.byte(index);
}

fn main() -> i64 {
    var literal: Str = "a\0\x80\xff";
    observe(literal);
    std::io::println_u8(literal.byte(1));
    std::io::println_u8(literal.byte(2));
    std::io::println_u8(literal.byte(-1));

    var copied: Str = literal;
    var reassigned: Str = "";
    reassigned = copied;
    observe(reassigned);

    var middle: Str = literal.slice(1, -1);
    std::io::println_u64(middle.len());
    std::io::println_u8(middle.byte(0));
    std::io::println_u8(middle.byte(-1));

    var caller: u8[] = u8[](2u);
    caller[0] = 'A';
    caller[1] = 'B';
    var frozen: Str = Str.from_bytes(caller);
    caller[0] = 'Z';
    observe(frozen);

    var independent: u8[] = middle.to_bytes();
    independent[0] = '!';
    std::io::println_u8(middle.byte(0));
    std::io::println_u8(independent[0]);

    var combined: Str = frozen.concat(middle);
    std::io::println_u64(combined.len());
    std::io::println_u8(combined.byte(0));
    std::io::println_u8(combined.byte(1));
    std::io::println_u8(combined.byte(-2));
    std::io::println_u8(combined.byte(-1));

    var temporary: u8 = concatenated_byte(
        Str.from_bytes(caller),
        literal.slice(-2, -1),
        -1
    );
    std::io::println_u8(temporary);

    var same_bytes: Str = "a\0\x80\xff";
    var middle_bytes: Str = "\0\x80";
    var other: Other = Other();
    std::io::println_bool(literal.equals(same_bytes));
    std::io::println_bool(middle.equals(middle_bytes));
    std::io::println_bool(literal.equals(middle));
    std::io::println_bool(literal.equals(other));
    return 0;
}
