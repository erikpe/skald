import std::io;
from std::test import assert_eq_u8;

class Probe {
    sequence: i64;
    bits: u8;

    init(bits: u8) {
        self.sequence = 0;
        self.bits = bits;
    }

    mut fn observe(value: i64, digit: i64) -> i64 {
        self.sequence = self.sequence * 10 + digit;
        return value;
    }

    fn masked(mask: u8) -> u8 {
        return ~self.bits & mask;
    }
}

fn combine(left: u64, right: u64) -> u64 {
    return ~left ^ right;
}

fn byte_identity(value: u8) -> u8 {
    return ~~value;
}

fn main() -> i64 {
    std::io::println_i64(~0);
    std::io::println_i64(~-1);
    std::io::println_i64(-0x8000000000000000 ^ 0x7fffffffffffffff);

    std::io::println_u64(~0u);
    std::io::println_u64(0xffffffffffffffffu & 0xffu);
    std::io::println_u64(0x8000000000000000u | 0xffu);
    std::io::println_u64(0xffffffffffffffffu ^ 0xaaaaaaaaaaaaaaaau);
    std::io::println_u64(combine(0xffffffffffffffffu, 0xaaaaaaaaaaaaaaaau));

    std::io::println_u8(~0x00u8);
    std::io::println_u8(0xf3u8 & 0x3fu8);
    std::io::println_u8(0x80u8 | 0x0fu8);
    std::io::println_u8(0xffu8 ^ 0xa5u8);
    std::io::println_u8(0xf0u8 & 0xccu8 ^ 0x0fu8 | 0x01u8);
    std::io::println_u8(byte_identity(0x55u8));

    var assigned: u64 = 0u;
    assigned = 0xf0f0u | 0x0f0fu;
    std::io::println_u64(assigned);

    var optional: u8? = 0xaau8;
    std::io::println_u8(~optional!);

    var values: u8[] = u8[](2u);
    values[0] = 0xf0u8;
    values[1] = 0x0fu8;
    std::io::println_u8(values[0] & values[1]);
    values[1] = ~values[0];
    std::io::println_u8(values[1]);

    var probe: Probe = Probe(0xf0u8);
    std::io::println_u8(probe.masked(0x3fu8));
    probe.bits = ~probe.bits;
    std::io::println_u8(probe.bits);

    std::io::println_i64(
        probe.observe(15, 1) & probe.observe(12, 2)
        ^ probe.observe(3, 3) | probe.observe(1, 4)
    );
    std::io::println_i64(~probe.observe(0, 5));
    std::io::println_i64(probe.sequence);

    std::io::println_bool(
        (0x1u & 0x1u) == 0x1u && (~0u == 0xffffffffffffffffu)
    );
    assert_eq_u8((u8) (0xffu & 0xaau), 0xaau8);
    return 0;
}
