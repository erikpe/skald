import std::io;

fn eighth(
    a: i64[],
    b: i64[],
    c: i64[],
    d: i64[],
    e: i64[],
    f: i64[],
    g: i64[],
    h: i64[]
) -> i64[] {
    h[0] = 80;
    return h;
}

fn recursive_copy(values: i64[], again: bool) -> i64[] {
    if (again) {
        return recursive_copy(values, false);
    }
    return values;
}

fn main() -> i64 {
    var selected: i64[] = eighth(
        i64[]{1},
        i64[]{2},
        i64[]{3},
        i64[]{4},
        i64[]{5},
        i64[]{6},
        i64[]{7},
        i64[]{8}
    );
    std::io::println_i64(selected[0]);

    var recursive: i64[] = recursive_copy(selected, true);
    recursive[0] = 90;
    std::io::println_i64(selected[0]);
    std::io::println_i64(recursive[0]);
    return 0;
}
