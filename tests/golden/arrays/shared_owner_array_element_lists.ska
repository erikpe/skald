import std::io;

interface Value {
    fn read() -> i64;
}

class Item implements Value {
    value: i64;

    init(value: i64) {
        self.value = value;
    }

    fn read() -> i64 {
        return self.value;
    }

    destroy {
        std::io::println_i64(self.value);
    }
}

fn make(value: i64) -> shared Item {
    return new Item(value);
}

fn exercise() -> unit {
    var named: shared Item = new Item(1);
    var erased: shared Obj = named;
    var inline: (shared Item)[] = (shared Item)[]{named, named, new Item(2), (shared Item) erased};
    var outer: shared (shared Value)[] = new (shared Value)[]{named, make(3)};
    var optional: (shared? Item)[] = (shared? Item)[]{none, named, make(4)};

    var first: shared Item = inline[0];
    first->value = 20;
    var repeated: shared Item = inline[1];
    var distinct: shared Item = inline[2];
    var view: shared Value = outer->[0];

    std::io::println_i64(repeated->value);
    std::io::println_i64(distinct->value);
    std::io::println_i64(view->read());
    std::io::println_bool(optional[0] is none);
    std::io::println_bool(optional[1] is some);

    var rows: (shared i64[])[] = (shared i64[])[]{new i64[]{7}, new i64[]{8, 9}};
    var row: shared i64[] = rows[1];
    std::io::println_i64(row->[1]);
    return;
}

fn main() -> i64 {
    exercise();
    return 0;
}
