import std::f64;
import std::io as io;

fn observe(bits: u64) -> unit {
    io::println_u64(std::f64::to_bits(std::f64::from_bits(bits)));
    return;
}

fn main() -> i64 {
    io::println_u64(std::f64::to_bits(0.0));
    io::println_u64(std::f64::to_bits(-0.0));
    io::println_u64(std::f64::to_bits(1.0));
    io::println_u64(std::f64::to_bits(1.0 / 0.0));
    io::println_u64(std::f64::to_bits(-(1.0 / 0.0)));

    observe(1u);
    observe(9218868437227405311u);
    observe(9218868437227405313u);
    observe(9221120237041090626u);

    if (std::f64::from_bits(4607182418800017408u) != 1.0) {
        return 1;
    }
    return 0;
}
