import std::io;

fn calculate(value: f64) -> f64 {
    var result: f64 = -(value * 2.0 + 0.5);
    return result;
}

fn choose(flag: bool, value: f64) -> f64 {
    if (flag) {
        var adjusted: f64 = value + 1.0;
        return adjusted;
    }
    else {
        return -value;
    }
}

fn register_mix(integer: u64, floating: f64, byte: u8, other: f64) -> f64 {
    std::io::println_u64(integer);
    std::io::println_u8(byte);
    return floating + other;
}

fn mixed(
    a: i64, b: f64, c: i64, d: f64,
    e: i64, f: f64, g: i64, h: f64,
    i: i64, j: f64, k: i64, l: f64,
    m: f64, n: f64, o: u64, p: f64
) -> f64 {
    std::io::println_u64(o);
    return p;
}

fn main() -> i64 {
    std::io::println_f64(0.0);
    std::io::println_f64(-0.0);
    std::io::println_f64(1.5);
    std::io::println_f64(4.9406564584124654e-324);
    std::io::println_f64(1.7976931348623157e308);
    std::io::println_f64(1e-400);
    std::io::println_f64(1.5 + 2.25);
    std::io::println_f64(5.5 - 2.0);
    std::io::println_f64(calculate(1.5));
    std::io::println_f64(choose(true, 1.5));
    std::io::println_f64(choose(false, 1.5));
    std::io::println_f64(register_mix(10u, 1.5, 20u8, 2.25));
    std::io::println_f64(mixed(
        1, 1.0, 2, 2.0,
        3, 3.0, 4, 4.0,
        5, 5.0, 6, 6.0,
        7.0, 8.0, 70u, 9.0
    ));
    return 0;
}
