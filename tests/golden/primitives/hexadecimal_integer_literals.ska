import std::io;

fn transform(value: u64) -> u64 {
    return (value | 0x2u) << 0x4u;
}

fn main() -> i64 {
    var signed_minimum: i64 = -(0X8000000000000000);
    var unsigned_maximum: u64 = 0xffffffffffffffffu;
    var bytes: u8[] = u8[](0x2u);
    bytes[0x0] = 0x41u8;
    bytes[0x1] = bytes[0x0] + 0x1u8;

    std::io::println_i64(signed_minimum);
    std::io::println_u64(unsigned_maximum);
    std::io::println_u8(0XFFu8);
    std::io::println_u64(transform(0x10u));
    std::io::println_u64((u64) bytes[0x0]);
    std::io::println_u8(bytes[0x1]);
    std::io::println_bool(
        transform(0x10u) == 0x120u && bytes[0x1] > 0x41u8
    );

    if (unsigned_maximum == 0XFFFFFFFFFFFFFFFFu && bytes[0x1] == 0x42u8) {
        return 0x0;
    }
    return 0x1;
}
