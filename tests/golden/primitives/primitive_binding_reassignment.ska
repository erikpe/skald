import std::io;

fn produce_signed() -> i64 {
    std::io::println_i64(100);
    return 41;
}

fn reassign_parameters(
    signed: i64,
    unsigned: u64,
    byte: u8,
    float: f64,
    flag: bool
) -> unit {
    signed = signed + 1;
    unsigned = unsigned + 1u;
    byte = byte + 1u8;
    float = float + 0.5;
    flag = true;
    std::io::println_i64(signed);
    std::io::println_u64(unsigned);
    std::io::println_u8(byte);
    std::io::println_f64(float);
    std::io::println_bool(flag);
}

fn main() -> i64 {
    var signed: i64 = 0;
    var unsigned: u64 = 0u;
    var byte: u8 = 0u8;
    var float: f64 = 0.0;
    var flag: bool = false;

    reassign_parameters(10, 11u, 12u8, 2.0, false);
    signed = 1;
    (signed) = produce_signed() + 1;
    unsigned = 18446744073709551615u;
    byte = 255u8;
    float = 2.5;
    flag = true;

    std::io::println_i64(signed);
    std::io::println_u64(unsigned);
    std::io::println_u8(byte);
    std::io::println_f64(float);
    std::io::println_bool(flag);

    var branch: i64 = 0;
    if (flag) {
        branch = 7;
        {
            var branch: i64 = 8;
            branch = 9;
            std::io::println_i64(branch);
        }
        branch = 10;
    }
    std::io::println_i64(branch);
    return 0;
}
