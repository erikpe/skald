import std::process;
from std::str import Str;
from std::test import assert_eq_f64, assert_eq_i64, assert_eq_str, assert_eq_u64, assert_eq_u8, assert_false, assert_true, fail;

fn passing_assertions() -> i64 {
    assert_eq_i64(-9223372036854775808, -9223372036854775808);
    assert_eq_i64(9223372036854775807, 9223372036854775807);
    assert_eq_u64(0u, 0u);
    assert_eq_u64(18446744073709551615u, 18446744073709551615u);
    assert_eq_u8(0u8, 0u8);
    assert_eq_u8(255u8, 255u8);
    assert_eq_f64(-0.0, 0.0);
    assert_eq_f64(1.0 / 0.0, 1.0 / 0.0);
    assert_eq_str("", "");
    assert_eq_str("same\0\xffbytes", "same\0\xffbytes");
    assert_true(true);
    assert_false(false);
    return 0;
}

fn main() -> i64 {
    var args: Str[] = std::process::args();
    if (args[1].equals("passing")) {
        return passing_assertions();
    }
    if (args[1].equals("equality-failure")) {
        assert_eq_i64(-1, 2);
        return 0;
    }
    fail("unexpected branch");
    return 0;
}
