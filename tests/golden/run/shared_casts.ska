import std::io;

interface Left {
    fn value() -> i64;
}

interface Right {
    fn value() -> i64;
}

class Root {
    init() {}

    virtual fn value() -> i64 {
        return 1;
    }
}

class Leaf extends Root implements Left, Right {
    init() {
        super();
    }

    override fn value() -> i64 {
        return 7;
    }
}

class LeftOnly implements Left {
    init() {}

    fn value() -> i64 {
        return 3;
    }
}

fn main() -> i64 {
    var erased: shared Obj = new Leaf();
    var leaf: shared Leaf = (shared Leaf) erased;
    var left: shared Left = leaf;
    var right: shared Right = (shared Right) left;
    var root: shared Root = (shared Root) new Leaf();
    std::io::println_i64(leaf->value());
    std::io::println_i64(right->value());
    std::io::println_i64(root->value());
    return 0;
}
