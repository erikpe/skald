extern fn ska_rt_println_u64(value: u64) -> unit;

fn i64_length(length: u64) -> u64 {
    var values: i64[] = i64[](length);
    return values.len();
}

fn empty_i64_length() -> u64 {
    var values: i64[] = i64[]();
    return values.len();
}

fn u64_length(length: u64) -> u64 {
    var values: u64[] = u64[](length);
    return values.len();
}

fn u8_length(length: u64) -> u64 {
    var values: u8[] = u8[](length);
    return values.len();
}

fn f64_length(length: u64) -> u64 {
    var values: f64[] = f64[](length);
    return values.len();
}

fn bool_length(length: u64) -> u64 {
    var values: bool[] = bool[](length);
    return values.len();
}

fn main() -> i64 {
    ska_rt_println_u64(empty_i64_length());
    ska_rt_println_u64(i64_length(0u));
    ska_rt_println_u64(i64_length(3u));
    ska_rt_println_u64(u64_length(4u));
    ska_rt_println_u64(u8_length(5u));
    ska_rt_println_u64(f64_length(6u));
    ska_rt_println_u64(bool_length(7u));
    return 0;
}
