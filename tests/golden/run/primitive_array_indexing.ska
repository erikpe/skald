import std::io;

fn main() -> i64 {
    var signed: i64[] = i64[](3u);
    var unsigned: u64[] = u64[](3u);
    var bytes: u8[] = u8[](3u);
    var floats: f64[] = f64[](3u);
    var flags: bool[] = bool[](3u);

    signed[0] = 10;
    signed[-1] = -20;
    unsigned[-2] = 30u;
    bytes[1] = 40u8;
    floats[-3] = 1.5;
    flags[-1] = true;

    std::io::println_i64(signed[-3]);
    std::io::println_i64(signed[1]);
    std::io::println_i64(signed[2]);
    std::io::println_u64(unsigned[1]);
    std::io::println_u8(bytes[-2]);
    std::io::println_f64(floats[0]);
    std::io::println_bool(flags[2]);
    return 0;
}
