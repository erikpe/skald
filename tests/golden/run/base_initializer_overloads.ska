import std::io;

fn observed() -> i64 {
    std::io::println_i64(90);
    return 7;
}

class Root {
    selected: i64;

    init(value: i64) {
        self.selected = value + 10;
    }

    init(value: bool) {
        self.selected = 20;
    }
}

class Derived extends Root {
    marker: i64;

    init() {
        super(observed());
        self.marker = 1;
    }

    init(value: bool) {
        super(value);
        self.marker = 2;
    }

    fn read() -> i64 {
        return self.selected + self.marker;
    }
}

fn main() -> i64 {
    var integer: Derived = Derived();
    var boolean: Derived = Derived(true);
    std::io::println_i64(integer.read());
    std::io::println_i64(boolean.read());
    return 0;
}
