extern fn ska_rt_println_i64(value: i64) -> unit;

class Animal {
    value: i64;

    init(value: i64) {
        self.value = value;
    }

    copy(ref source: Animal) {
        self.value = source.value;
    }

    fn read() -> i64 {
        return self.value;
    }
}

class Dog extends Animal {
    extra: i64;

    init(value: i64, extra: i64) {
        super(value);
        self.extra = extra;
    }

    copy(ref source: Dog) {
        self.extra = source.extra;
    }

    fn total() -> i64 {
        return self.value + self.extra;
    }
}

fn slice_alias(ref dog: Dog) -> shared Animal {
    return new Animal(copy dog);
}

fn copy_checked(source: shared Animal) -> shared Dog {
    return new Dog(copy *source);
}

fn main() -> i64 {
    var inline: Dog = Dog(10, 5);
    var sliced: shared Animal = slice_alias(inline);
    var source: shared Animal = new Dog(20, 7);
    var checked: shared Dog = copy_checked(source);
    var produced: shared Animal = new Animal(copy *new Dog(30, 9));
    ska_rt_println_i64(sliced->read());
    ska_rt_println_i64(checked->total());
    ska_rt_println_i64(produced->read());
    return 0;
}
