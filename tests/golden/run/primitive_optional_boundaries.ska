class Holder {
    value: i64?;

    init(value: i64?) {
        self.value = value;
    }

    mut fn replace(value: i64?) -> i64? {
        self.value = value;
        return self.value;
    }
}

fn identity(value: i64?) -> i64? {
    return value;
}

fn main() -> i64 {
    var holder: Holder = Holder(none);
    var result: i64? = holder.replace(identity(42));
    var copy: Holder = holder;
    copy = holder;
    return copy.value!;
}
