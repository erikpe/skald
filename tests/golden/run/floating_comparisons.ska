import std::io;

fn zero() -> f64 {
    return 0.0;
}

fn positive_zero() -> f64 {
    return 0.0 / 1.0;
}

fn negative_zero() -> f64 {
    return 0.0 / -1.0;
}

fn positive_infinity() -> f64 {
    return 1.0 / zero();
}

fn negative_infinity() -> f64 {
    return -1.0 / zero();
}

fn not_a_number() -> f64 {
    return zero() / zero();
}

fn mark(marker: i64, value: f64) -> f64 {
    std::io::println_i64(marker);
    return value;
}

fn compare(left: f64, right: f64) -> bool {
    return left < right;
}

fn returned(left: f64, right: f64) -> bool {
    return left > right;
}

fn consume(value: bool) -> bool {
    return value;
}

class Box {
    value: f64;
    flag: bool;

    init(value: f64) {
        self.value = value;
        self.flag = false;
    }
}

class Trace {
    marker: i64;
    value: f64;

    init(marker: i64, value: f64) {
        self.marker = marker;
        self.value = value;
    }

    fn read() -> f64 {
        return self.value;
    }

    destroy {
        std::io::println_i64(100 + self.marker);
    }
}

fn make(marker: i64, value: f64) -> shared Trace {
    return new Trace(marker, value);
}

fn main() -> i64 {
    std::io::println_bool(1.0 == 2.0);
    std::io::println_bool(1.0 != 2.0);
    std::io::println_bool(1.0 < 2.0);
    std::io::println_bool(1.0 <= 2.0);
    std::io::println_bool(1.0 > 2.0);
    std::io::println_bool(1.0 >= 2.0);

    std::io::println_bool(2.0 == 2.0);
    std::io::println_bool(2.0 != 2.0);
    std::io::println_bool(2.0 < 2.0);
    std::io::println_bool(2.0 <= 2.0);
    std::io::println_bool(2.0 > 2.0);
    std::io::println_bool(2.0 >= 2.0);

    var nan: f64 = not_a_number();
    std::io::println_bool(nan == 1.0);
    std::io::println_bool(nan != 1.0);
    std::io::println_bool(nan < 1.0);
    std::io::println_bool(nan <= 1.0);
    std::io::println_bool(nan > 1.0);
    std::io::println_bool(nan >= 1.0);

    std::io::println_bool(1.0 == nan);
    std::io::println_bool(1.0 != nan);
    std::io::println_bool(1.0 < nan);
    std::io::println_bool(1.0 <= nan);
    std::io::println_bool(1.0 > nan);
    std::io::println_bool(1.0 >= nan);

    var positive: f64 = positive_zero();
    var negative: f64 = negative_zero();
    std::io::println_bool(positive == negative);
    std::io::println_bool(positive != negative);
    std::io::println_bool(positive < negative);
    std::io::println_bool(positive <= negative);
    std::io::println_bool(positive > negative);
    std::io::println_bool(positive >= negative);

    var low: f64 = negative_infinity();
    var high: f64 = positive_infinity();
    std::io::println_bool(low < -1.0);
    std::io::println_bool(-1.0 < high);
    std::io::println_bool(high > 1.0);
    std::io::println_bool(low == negative_infinity());
    std::io::println_bool(high >= positive_infinity());

    var values: f64[] = f64[](2u);
    values[0] = 2.0;
    values[1] = 5.0;
    var optional: f64? = 3.0;
    var flags: bool[] = bool[](1u);
    var box: Box = Box(4.0);

    var result: bool = consume(values[0] < optional!);
    std::io::println_bool(result);
    result = compare(box.value, values[1]);
    std::io::println_bool(result);
    box.flag = !(box.value >= optional!);
    std::io::println_bool(box.flag);
    flags[0] = returned(values[1], box.value);
    std::io::println_bool(flags[0]);

    if (box.value > optional!) {
        std::io::println_bool(true);
    }
    elif (box.value == optional!) {
        std::io::println_bool(false);
    }

    var iterations: i64 = 0;
    while (values[0] < optional! && iterations < 1) {
        iterations = iterations + 1;
    }
    std::io::println_i64(iterations);

    std::io::println_bool(mark(1, 8.0) < mark(2, 9.0));
    std::io::println_bool(false && mark(90, 1.0) < mark(91, 2.0));
    std::io::println_bool(true || mark(92, 1.0) < mark(93, 2.0));
    std::io::println_bool(true && mark(93, 1.0) < mark(94, 2.0));
    std::io::println_bool(make(3, 1.0)->read() < make(4, 2.0)->read());
    return 0;
}
