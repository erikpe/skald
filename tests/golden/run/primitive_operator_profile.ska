import std::io;

fn floor_quotient(dividend: i64, divisor: i64) -> i64 {
    return dividend / divisor;
}

fn mark(marker: i64, value: f64) -> f64 {
    std::io::println_i64(marker);
    return value;
}

class Probe {
    marker: i64;
    value: f64;
    flag: bool;

    init(marker: i64, value: f64) {
        self.marker = marker;
        self.value = value;
        self.flag = false;
    }

    fn scaled(divisor: f64) -> f64 {
        return (self.value + 2.0) / divisor;
    }

    mut fn record(value: bool) -> bool {
        self.flag = value;
        return self.flag;
    }

    destroy {
        std::io::println_i64(100 + self.marker);
    }
}

fn make(marker: i64, value: f64) -> shared Probe {
    return new Probe(marker, value);
}

fn main() -> i64 {
    var values: f64[] = f64[](2u);
    values[0] = 6.0;
    values[1] = 3.0;
    var optional: f64? = 2.0;
    var flags: bool[] = bool[](1u);
    var byte: u8 = ((~1u8 & 15u8) | (16u8 ^ 2u8)) >> 2u;

    var selected: bool = values[0] / optional! + values[1] * 2.0 - 1.0 == 8.0
        && floor_quotient(-7, 3) == -3
        && -7 % 3 == 2
        && byte == 7u8
        && -8 >> 2u == -2
        && 1u << 63u > 0u
        && optional is some
        && !false == true;
    std::io::println_bool(selected);

    var probe: Probe = Probe(0, 8.0);
    flags[0] = probe.record(selected && probe.value / 4.0 == 2.0);
    std::io::println_bool(flags[0]);

    if (flags[0]) {
        std::io::println_i64(1);
    }
    elif (probe.value == 0.0) {
        std::io::println_i64(-1);
    }

    var rounds: i64 = 0;
    while (flags[0] && rounds < 2) {
        rounds = rounds + 1;
    }
    std::io::println_i64(rounds);

    var nan: f64 = 0.0 / 0.0;
    std::io::println_bool(nan == nan);
    std::io::println_bool(nan != nan);
    std::io::println_bool(nan < nan);
    std::io::println_bool(nan <= nan);
    std::io::println_bool(nan > nan);
    std::io::println_bool(nan >= nan);

    var positive_zero: f64 = 0.0 / 1.0;
    var negative_zero: f64 = 0.0 / -1.0;
    std::io::println_bool(positive_zero == negative_zero);

    var positive_infinity: f64 = 1.0 / 0.0;
    var negative_infinity: f64 = -1.0 / 0.0;
    std::io::println_bool(
        negative_infinity < -1.0
        && positive_infinity > 1.0
        && negative_infinity < positive_infinity
    );
    std::io::println_f64(positive_infinity);

    selected = mark(10, 8.0) / mark(11, 2.0) == 4.0
        && make(1, 8.0)->scaled(2.0) > make(2, 4.0)->scaled(2.0)
        && floor_quotient(7, -3) == -3
        && 7 % -3 == -2;
    std::io::println_bool(selected);

    std::io::println_bool(true || floor_quotient(1, 0) == 0);
    std::io::println_bool(false && 1u8 << 8u == 0u8);
    return 0;
}
