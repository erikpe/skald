import std::io;

class Holder {
    bits: u64;
    count: u64;

    init(bits: u64, count: u64) {
        self.bits = bits;
        self.count = count;
    }
}

class Probe {
    sequence: i64;

    init() {
        self.sequence = 0;
    }

    mut fn observe(value: u64, digit: i64) -> u64 {
        self.sequence = self.sequence * 10 + digit;
        return value;
    }
}

class Trace {
    marker: i64;
    value: u64;

    init(marker: i64, value: u64) {
        self.marker = marker;
        self.value = value;
    }

    fn read() -> u64 {
        return self.value;
    }

    destroy {
        std::io::println_i64(self.marker);
    }
}

fn shift_parameter(left: u64, count: u64) -> u64 {
    return left << count;
}

fn shift_return(value: u8) -> u8 {
    return value >> 1u;
}

fn consume(value: u64) -> unit {
    std::io::println_u64(value);
}

fn produce_trace(marker: i64, value: u64) -> Trace {
    return Trace(marker, value);
}

fn read_trace(value: Trace) -> u64 {
    return value.value;
}

fn make_trace(marker: i64, value: u64) -> shared Trace {
    return new Trace(marker, value);
}

fn main() -> i64 {
    std::io::println_i64(1 << 0u);
    std::io::println_i64(0x1 << 63u);
    std::io::println_i64(-8 >> 1u);
    std::io::println_i64(-1 >> 63u);

    std::io::println_u64(0x1u << 63u);
    std::io::println_u64(0xffffffffffffffffu >> 63u);
    std::io::println_u64(0x8000000000000000u << 1u);

    std::io::println_u8(0x01u8 << 7u);
    std::io::println_u8(0x81u8 >> 7u);
    std::io::println_u8(0x81u8 << 1u);
    std::io::println_u8(shift_return(0xf0u8));

    var assigned: u64 = 0u;
    assigned = shift_parameter(3u, 4u);
    consume(assigned);

    var holder: Holder = Holder(0x80u, 3u);
    std::io::println_u64(holder.bits >> holder.count);
    holder.bits = holder.bits << 1u;
    std::io::println_u64(holder.bits);

    var optional: u64? = 5u;
    std::io::println_u64(optional! << ((u64) 2));
    optional = 3u << 5u;
    std::io::println_u64(optional!);

    var values: u64[] = u64[](2u);
    values[0] = 9u;
    values[1] = 1u;
    std::io::println_u64(values[0] << values[1]);
    values[1] = values[0] >> 2u;
    std::io::println_u64(values[1]);

    std::io::println_u64(0x100u >> 1u >> 2u);
    std::io::println_u64(0x1u << (2u + 3u) & 0x3fu);

    var probe: Probe = Probe();
    std::io::println_u64(probe.observe(8u, 1) >> probe.observe(1u, 2));
    std::io::println_i64(probe.sequence);
    std::io::println_bool(
        (probe.observe(3u, 3) << probe.observe(2u, 4)) == 12u
        && (probe.observe(32u, 5) >> 5u) == 1u
    );
    std::io::println_i64(probe.sequence);

    std::io::println_u64(
        read_trace(produce_trace(41, 1u)) << read_trace(produce_trace(42, 3u))
    );
    std::io::println_u64(
        make_trace(51, 16u)->read() >> make_trace(52, 2u)->read()
    );

    if ((0x01u8 << 7u) == 0x80u8 && (0xffu8 >> 7u) == 0x01u8) {
        return 93;
    }
    return 1;
}
