extern fn ska_rt_println_bool(value: bool) -> unit;

fn through_parameter(value: bool) -> bool {
    return value;
}

fn function_value() -> bool {
    return true;
}

fn main() -> i64 {
    ska_rt_println_bool(false);
    var local: bool = true;
    ska_rt_println_bool(local);
    ska_rt_println_bool(through_parameter(false));
    ska_rt_println_bool(function_value());
    return 74;
}
