extern fn ska_rt_println_f64_bits(value: f64) -> unit;

fn calculate(value: f64) -> f64 {
    var result: f64 = -(value * 2.0 + 0.5);
    return result;
}

fn choose(flag: bool, value: f64) -> f64 {
    if (flag) {
        var adjusted: f64 = value + 1.0;
        return adjusted;
    }
    else {
        return -value;
    }
}

fn mixed(
    a: i64, b: f64, c: i64, d: f64,
    e: i64, f: f64, g: i64, h: f64,
    i: i64, j: f64, k: i64, l: f64,
    m: f64, n: f64, o: i64, p: f64
) -> f64 {
    return p;
}

fn main() -> i64 {
    ska_rt_println_f64_bits(0.0);
    ska_rt_println_f64_bits(-0.0);
    ska_rt_println_f64_bits(1.5);
    ska_rt_println_f64_bits(4.9406564584124654e-324);
    ska_rt_println_f64_bits(1.7976931348623157e308);
    ska_rt_println_f64_bits(1e-400);
    ska_rt_println_f64_bits(1.5 + 2.25);
    ska_rt_println_f64_bits(5.5 - 2.0);
    ska_rt_println_f64_bits(calculate(1.5));
    ska_rt_println_f64_bits(choose(true, 1.5));
    ska_rt_println_f64_bits(choose(false, 1.5));
    ska_rt_println_f64_bits(mixed(
        1, 1.0, 2, 2.0,
        3, 3.0, 4, 4.0,
        5, 5.0, 6, 6.0,
        7.0, 8.0, 7, 9.0
    ));
    return 0;
}
