extern fn ska_rt_println_i64(value: i64) -> unit;

class Base {
    tag: u8;
    value: i64;

    init(value: i64) {
        self.tag = 1u8;
        self.value = value;
    }

    init(ref other: Base) {
        self.tag = other.tag;
        self.value = other.value + 10;
    }

    assign(ref other: Base) {
        self.tag = other.tag;
        self.value = other.value + 20;
    }

    destroy {
        ska_rt_println_i64(3000 + self.value);
    }
}

class Middle extends Base {
    init(value: i64) {
        super(value);
    }

    destroy {
        ska_rt_println_i64(4000 + self.value);
    }
}

class Leaf extends Middle {
    marker: u8;
    extra: i64;

    init(value: i64, extra: i64) {
        super(value);
        self.marker = 2u8;
        self.extra = extra;
    }

    destroy {
        ska_rt_println_i64(5000 + self.extra);
    }
}

fn inspect(ref base: Base) -> i64 {
    return base.value;
}

fn accept_any(ref value: Obj) -> unit {}

fn forward_any(ref value: Obj) -> unit {
    accept_any(value);
}

fn pressure(
    first: i64,
    second: i64,
    third: i64,
    fourth: i64,
    fifth: i64,
    sixth: i64,
    ref base: Base,
    ratio: f64
) -> i64 {
    return first + second + third + fourth + fifth + sixth + base.value;
}

fn sliced_result(ref leaf: Leaf) -> Base {
    return leaf;
}

fn consume(value: Base) -> unit {
    ska_rt_println_i64(value.value);
}

fn main() -> i64 {
    var leaf: Leaf = Leaf(7, 70);
    ska_rt_println_i64(inspect(leaf));
    forward_any(leaf);
    ska_rt_println_i64(pressure(1, 2, 3, 4, 5, 6, leaf, 2.5));

    var copied: Leaf = leaf;
    ska_rt_println_i64(copied.value);
    ska_rt_println_i64(copied.extra);

    copied = leaf;
    ska_rt_println_i64(copied.value);

    var sliced: Base = sliced_result(leaf);
    ska_rt_println_i64(sliced.value);
    consume(Leaf(9, 90));
    return 0;
}
