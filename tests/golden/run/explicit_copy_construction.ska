import std::io;

class Base {
    value: i64;

    init(value: i64) {
        self.value = value;
    }

    copy(ref source: Base) {
        self.value = source.value + 10;
    }
}

class Leaf extends Base {
    extra: i64;

    init(value: i64, extra: i64) {
        super(value);
        self.extra = extra;
    }
}

fn make_leaf(value: i64, extra: i64) -> Leaf {
    std::io::println_i64(900);
    return Leaf(value, extra);
}

fn checked_downcast(ref source: Base) -> Leaf {
    return Leaf(copy source);
}

fn main() -> i64 {
    var leaf: Leaf = Leaf(7, 70);
    var produced: Leaf = Leaf(copy make_leaf(7, 70));
    std::io::println_i64(produced.value);
    std::io::println_i64(produced.extra);

    var sliced: Base = Base(copy leaf);
    std::io::println_i64(sliced.value);

    var narrowed: Leaf = checked_downcast(leaf);
    std::io::println_i64(narrowed.value);
    std::io::println_i64(narrowed.extra);
    return 0;
}
