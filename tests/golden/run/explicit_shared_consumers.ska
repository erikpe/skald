extern fn ska_rt_println_i64(value: i64) -> unit;

class Leaf {
    value: i64;

    init(value: i64) {
        self.value = value;
    }

    copy(ref source: Leaf) {
        self.value = source.value;
    }
}

class Holder {
    edge: shared Leaf;
    inline_copy: Leaf;

    init(owner: shared Leaf) {
        self.edge = owner;
        self.inline_copy = *owner;
    }
}

fn inspect(ref value: Leaf) -> i64 {
    return value.value;
}

fn increment(mut ref value: Leaf) -> unit {
    value.value = value.value + 1;
}

fn consume(value: Leaf) -> i64 {
    return value.value;
}

fn copy_result(owner: shared Leaf) -> Leaf {
    return *owner;
}

fn produce(value: i64) -> shared Leaf {
    return new Leaf(value);
}

fn main() -> i64 {
    var owner: shared Leaf = new Leaf(5);
    ska_rt_println_i64(inspect(owner));
    ska_rt_println_i64(inspect(*owner));

    increment(*owner);
    var holder: Holder = Holder(owner);
    var copied: Leaf = *owner;
    var assigned: Leaf = Leaf(0);
    assigned = *holder.edge;
    var consumed: i64 = consume(*owner);
    var returned: Leaf = copy_result(owner);
    var constructed: Leaf = Leaf(copy *owner);
    var allocated: shared Leaf = new Leaf(copy *holder.edge);
    var produced: Leaf = Leaf(copy *produce(7));

    ska_rt_println_i64(holder.inline_copy.value);
    ska_rt_println_i64(copied.value);
    ska_rt_println_i64(assigned.value);
    ska_rt_println_i64(consumed);
    ska_rt_println_i64(returned.value);
    ska_rt_println_i64(constructed.value);
    ska_rt_println_i64(allocated->value);
    ska_rt_println_i64(produced.value);
    return 0;
}
