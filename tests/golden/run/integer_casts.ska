extern fn ska_rt_println_i64(value: i64) -> unit;
extern fn ska_rt_println_u64(value: u64) -> unit;
extern fn ska_rt_println_u8(value: u8) -> unit;

class CastFields {
    small: u8;
    wide: u64;

    init(value: i64) {
        self.small = (u8) value;
        self.wide = (u64) self.small;
    }
}

fn narrow(value: u64) -> u8 {
    return (u8) value;
}

fn widen(value: u8) -> u64 {
    return (u64) value;
}

fn reinterpret(value: u64) -> i64 {
    return (i64) value;
}

fn main() -> i64 {
    ska_rt_println_i64((i64) -9223372036854775808);
    ska_rt_println_i64((i64) 9223372036854775807);
    ska_rt_println_u64((u64) 18446744073709551615u);

    ska_rt_println_u64((u64) -1);
    ska_rt_println_u64((u64) -9223372036854775808);
    ska_rt_println_u64((u64) 9223372036854775807);
    ska_rt_println_i64((i64) 9223372036854775807u);
    ska_rt_println_i64((i64) 9223372036854775808u);
    ska_rt_println_i64((i64) 18446744073709551615u);

    ska_rt_println_u8((u8) 0u);
    ska_rt_println_u8((u8) 255u);
    ska_rt_println_u8((u8) 256u);
    ska_rt_println_u8((u8) 258u);
    ska_rt_println_u8((u8) 18446744073709551615u);
    ska_rt_println_u8((u8) -1);
    ska_rt_println_u8((u8) -9223372036854775808);
    ska_rt_println_u8((u8) 9223372036854775807);

    ska_rt_println_i64((i64) 0u8);
    ska_rt_println_i64((i64) 127u8);
    ska_rt_println_i64((i64) 128u8);
    ska_rt_println_i64((i64) 255u8);
    ska_rt_println_u64((u64) 255u8);
    ska_rt_println_u8((u8) 255u8);

    ska_rt_println_u8(narrow(258u));
    ska_rt_println_u64(widen(255u8));
    ska_rt_println_i64(reinterpret(18446744073709551615u));

    var fields: CastFields = CastFields(-1);
    ska_rt_println_u8(fields.small);
    ska_rt_println_u64(fields.wide);
    ska_rt_println_u64((u64) ((u8) 258u + 40u8));

    if ((i64) 18446744073709551615u == -1) {
        if ((u8) -1 == 255u8) {
            if ((u64) 128u8 == 128u) {
                return 84;
            }
        }
    }
    return 1;
}
