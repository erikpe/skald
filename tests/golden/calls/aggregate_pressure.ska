from std::test import assert_eq_i64, assert_eq_f64;

class Result {
    integer: i64;
    floating: f64;
    init(integer: i64, floating: f64) {
        self.integer = integer;
        self.floating = floating;
    }
}

interface Builder {
    fn build(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64,
        x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64,
        x7: f64, x8: f64, x9: f64) -> Result;
}

class Factory implements Builder {
    bias: i64;
    init(bias: i64) { self.bias = bias; }
    fn build(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64,
        x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64,
        x7: f64, x8: f64, x9: f64) -> Result {
        return Result(self.bias + a + b * 10 + c * 100 + d * 1000
            + e * 10000 + f * 100000 + g * 1000000,
            x1 + x2 * 2.0 + x3 * 3.0 + x4 * 4.0 + x5 * 5.0
            + x6 * 6.0 + x7 * 7.0 + x8 * 8.0 + x9 * 9.0);
    }
}

fn integer(value: i64) -> i64 { return value; }
fn floating(value: f64) -> f64 { return value; }

fn indirect(ref builder: Builder) -> Result {
    // The hidden result and receiver triple compete with integer arguments;
    // the ninth floating argument also crosses the register/stack boundary.
    return builder.build(integer(1), integer(2), integer(3), integer(4),
        integer(5), integer(6), integer(7), floating(1.0), floating(2.0),
        floating(3.0), floating(4.0), floating(5.0), floating(6.0),
        floating(7.0), floating(8.0), floating(9.0));
}

fn check(ref result: Result) -> unit {
    assert_eq_i64(result.integer, 7655321);
    assert_eq_f64(result.floating, 285.0);
}

fn main() -> i64 {
    var factory: Factory = Factory(1000);
    var direct: Result = factory.build(integer(1), integer(2), integer(3),
        integer(4), integer(5), integer(6), integer(7), floating(1.0),
        floating(2.0), floating(3.0), floating(4.0), floating(5.0),
        floating(6.0), floating(7.0), floating(8.0), floating(9.0));
    check(direct);
    var dynamic: Result = indirect(factory);
    check(dynamic);
    assert_eq_i64(factory.bias, 1000);
    return 0;
}
