from std::test import assert_eq_i64;

fn twice(value: i64) -> i64 {
    return value * 2;
}

fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn observe(value: i64) -> unit {}

fn register_sum(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    return a + b + c + d + e + f;
}

fn stack_edges(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64 {
    return a + g;
}

fn main() -> i64 {
    assert_eq_i64(twice(21), 42);
    observe(42);
    assert_eq_i64(add(twice(5), add(2, 3)), 15);
    assert_eq_i64(register_sum(1, 2, 3, 4, 5, 6), 21);
    assert_eq_i64(stack_edges(1, 2, 3, 4, 5, 6, 7), 8);
    return 0;
}
