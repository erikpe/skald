interface Ranked {
    fn rank() -> i64;
}

class Item implements Ranked {
    value: i64;

    init(value: i64) {
        self.value = value;
    }

    copy(ref source: Item) {
        self.value = source.value;
    }

    assign(ref source: Item) {
        self.value = source.value;
    }

    fn rank() -> i64 {
        return self.value;
    }
}

class Tracked {
    static destroyed: i64;
    value: i64;

    init(value: i64) {
        self.value = value;
    }

    copy(ref source: Tracked) {
        self.value = source.value;
    }

    assign(ref source: Tracked) {
        self.value = source.value;
    }

    destroy {
        Tracked.destroyed = Tracked.destroyed + 1;
    }
}

class Box<T> {
    value: T;

    init(value: T) {
        self.value = value;
    }

    copy(ref source: Box<T>) {
        self.value = source.value;
    }

    assign(ref source: Box<T>) {
        self.value = source.value;
    }

    mut fn replace(ref value: T) -> unit {
        self.value = value;
    }

    fn get() -> T {
        return self.value;
    }
}

class Store<T> {
    static last: T?;
    values: T?[];

    init(length: u64) {
        self.values = T?[](length);
    }

    mut fn put(index: i64, value: T?) -> unit {
        self.values[index] = value;
        Store<T>::last = value;
    }
}

class Reader<T>
where T: Ranked
{
    value: T;

    init(value: T) {
        self.value = value;
    }

    fn read() -> i64 {
        return self.value.rank();
    }
}

fn exercise_cleanup() -> i64 {
    var first_value: Tracked = Tracked(40);
    var second_value: Tracked = Tracked(42);
    var first: Box<Tracked> = Box<Tracked>(first_value);
    var second: Box<Tracked> = Box<Tracked>(copy first);
    second.replace(second_value);
    first = second;
    return first.get().value;
}

fn main() -> i64 {
    var value: i64 = exercise_cleanup();
    if (Tracked.destroyed == 0) {
        return 1;
    }

    var owner: shared Item = new Item(value);
    var store: Store<shared Item> = Store<shared Item>(2u);
    store.put(0, owner);
    var missing: (shared Item)? = store.values[1];
    if (missing is some || Store<shared Item>::last is none) {
        return 2;
    }

    var item: Item = Item(value);
    var reader: Reader<Item> = Reader<Item>(item);
    return reader.read();
}
