import std::io;

fn through_parameter(value: bool) -> bool {
    return value;
}

fn function_value() -> bool {
    return true;
}

fn main() -> i64 {
    std::io::println_bool(false);
    var local: bool = true;
    std::io::println_bool(local);
    std::io::println_bool(through_parameter(false));
    std::io::println_bool(function_value());
    return 74;
}
