import std::io;

fn seventh(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64) -> u64 {
    return g;
}

fn step(value: u64) -> u64 {
    return value + 1u;
}

fn main() -> i64 {
    var one: u64 = 1u;
    var maximum: u64 = 18446744073709551615u;
    std::io::println_u64(0u);
    std::io::println_u64(one);
    std::io::println_u64(maximum);
    std::io::println_u64(maximum + 1u);
    std::io::println_u64(0u - 1u);
    std::io::println_u64(9223372036854775808u * 3u);
    std::io::println_u64(step(one));
    std::io::println_u64(seventh(1u, 2u, 3u, 4u, 5u, 6u, 7u));
    return 0;
}
