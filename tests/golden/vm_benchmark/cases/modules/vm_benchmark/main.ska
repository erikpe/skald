from std::error import panic;
from std::io import write_stdout;
from std::test import assert_eq_str, assert_true;
import vm_benchmark::cases as cases;
import vm_benchmark::model as model;
import vm_benchmark::opcodes as opcodes;
import vm_benchmark::runtime as runtime;

fn mix_aggregate_result(
    seed: i64,
    index: i64,
    ref result: model::BenchmarkResult
) -> i64 {
    var checksum: i64 = seed;
    checksum = opcodes::mix_checksum(checksum, index);
    checksum = opcodes::mix_checksum(checksum, (i64) result.name.len());
    checksum = opcodes::mix_checksum(checksum, result.return_value);
    checksum = opcodes::mix_checksum(checksum, result.memory0);
    checksum = opcodes::mix_checksum(checksum, result.memory_checksum);
    checksum = opcodes::mix_checksum(checksum, result.trace_sum);
    checksum = opcodes::mix_checksum(checksum, (i64) result.instruction_count);
    checksum = opcodes::mix_checksum(checksum, (i64) result.call_count);
    checksum = opcodes::mix_checksum(checksum, (i64) result.branch_count);
    checksum = opcodes::mix_checksum(checksum, (i64) result.builtin_calls);
    return opcodes::mix_checksum(checksum, result.checksum());
}

fn aggregate_results(ref results: model::BenchmarkResult[]) -> model::BenchmarkAggregate {
    var total_return_value: i64 = 0;
    var total_memory0: i64 = 0;
    var total_memory_checksum: i64 = 0;
    var total_trace_sum: i64 = 0;
    var total_instruction_count: u64 = 0u;
    var total_call_count: u64 = 0u;
    var total_branch_count: u64 = 0u;
    var total_builtin_calls: u64 = 0u;
    var checksum_value: i64 = 0;

    for (index in 0 .. (i64) results.len()) {
        total_return_value = total_return_value + results[index].return_value;
        total_memory0 = total_memory0 + results[index].memory0;
        total_memory_checksum =
            total_memory_checksum + results[index].memory_checksum;
        total_trace_sum = total_trace_sum + results[index].trace_sum;
        total_instruction_count =
            total_instruction_count + results[index].instruction_count;
        total_call_count = total_call_count + results[index].call_count;
        total_branch_count = total_branch_count + results[index].branch_count;
        total_builtin_calls = total_builtin_calls + results[index].builtin_calls;
        checksum_value = mix_aggregate_result(checksum_value, index, results[index]);
    }

    checksum_value = opcodes::mix_checksum(checksum_value, (i64) results.len());
    checksum_value = opcodes::mix_checksum(checksum_value, total_return_value);
    checksum_value = opcodes::mix_checksum(checksum_value, total_memory0);
    checksum_value = opcodes::mix_checksum(checksum_value, total_memory_checksum);
    checksum_value = opcodes::mix_checksum(checksum_value, total_trace_sum);
    checksum_value = opcodes::mix_checksum(checksum_value, (i64) total_instruction_count);
    checksum_value = opcodes::mix_checksum(checksum_value, (i64) total_call_count);
    checksum_value = opcodes::mix_checksum(checksum_value, (i64) total_branch_count);
    checksum_value = opcodes::mix_checksum(checksum_value, (i64) total_builtin_calls);

    return model::BenchmarkAggregate(
        results.len(), total_return_value, total_memory0, total_memory_checksum,
        total_trace_sum, total_instruction_count, total_call_count,
        total_branch_count, total_builtin_calls, checksum_value
    );
}

fn aggregate_expected_cases(
    ref benchmark_cases: model::BenchmarkCase[]
) -> model::BenchmarkAggregate {
    var expected_results: model::BenchmarkResult[] =
        model::BenchmarkResult[](benchmark_cases.len());
    for (index in 0u .. benchmark_cases.len()) {
        expected_results[(i64) index] =
            benchmark_cases[(i64) index].expected_result();
    }
    return aggregate_results(expected_results);
}

fn run_case_checked(ref benchmark_case: model::BenchmarkCase) -> model::BenchmarkResult {
    var result: model::BenchmarkResult = runtime::run_case(benchmark_case);
    assert_true(result.matches_expected(benchmark_case));
    assert_eq_str(result.render(), benchmark_case.expected_output_line());
    return result;
}

public fn run_case_and_report(case_index: u64) -> i64 {
    var benchmark_cases: model::BenchmarkCase[] = cases::build_cases();
    if (case_index >= benchmark_cases.len()) {
        panic("vm_benchmark.run_case_and_report: case index out of bounds");
    }

    var result: model::BenchmarkResult = run_case_checked(
        benchmark_cases[(i64) case_index]
    );
    write_stdout(result.render().concat("\n"));
    return 0;
}

public fn num_cases() -> u64 {
    var benchmark_cases: model::BenchmarkCase[] = cases::build_cases();
    return benchmark_cases.len();
}

public fn run_and_report() -> i64 {
    var benchmark_cases: model::BenchmarkCase[] = cases::build_cases();
    var results: model::BenchmarkResult[] =
        model::BenchmarkResult[](benchmark_cases.len());
    for (index in 0u .. benchmark_cases.len()) {
        results[(i64) index] = run_case_checked(benchmark_cases[(i64) index]);
    }

    var aggregate: model::BenchmarkAggregate = aggregate_results(results);
    var expected: model::BenchmarkAggregate =
        aggregate_expected_cases(benchmark_cases);
    assert_eq_str(aggregate.render(), expected.render());
    write_stdout(aggregate.render().concat("\n"));
    return 0;
}
