fn extended_builtin_table() -> (shared model::Builtin)[] {
    return (shared model::Builtin)[]{
        new builtins::TraceAccumulatorBuiltin("trace_accumulate"),
        new builtins::ConstPoolMixBuiltin("const_pool_mix"),
        new builtins::RangeFoldBuiltin("range_fold")
    };
}

fn build_builtin_dispatch_program() -> shared model::Program {
    var code: ((shared model::Instruction)?)[] =
        ((shared model::Instruction)?)[](18u);
    code[0] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 0, 0u);
    code[1] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 1, 1u);
    code[2] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 2, 2u);
    code[3] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 3, 3u);
    code[4] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 4, 4u);
    code[5] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 5, 5u);
    code[6] = new instructions::CallBuiltinOp(
        opcodes::call_builtin_opcode(), 1u, 6u
    );
    code[7] = new instructions::RegisterCopyOp(opcodes::move_opcode(), 6, 0);
    code[8] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 0, 6u);
    code[9] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 1, 7u);
    code[10] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 2, 8u);
    code[11] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 3, 9u);
    code[12] = new instructions::CallBuiltinOp(
        opcodes::call_builtin_opcode(), 2u, 4u
    );
    code[13] = new instructions::AddOp(opcodes::add_opcode(), 7, 6, 0);
    code[14] = new instructions::StoreMemOp(opcodes::store_mem_opcode(), 0, 7);
    code[15] = new instructions::RegisterCopyOp(opcodes::move_opcode(), 0, 7);
    code[16] = new instructions::CallBuiltinOp(
        opcodes::call_builtin_opcode(), 0u, 1u
    );
    code[17] = new instructions::HaltOp(opcodes::halt_opcode(), 7);

    var functions: model::FunctionInfo[] = model::FunctionInfo[]{
        model::FunctionInfo("main", 0u, 8u, code)
    };
    var constants: (shared Obj)[] = (shared Obj)[]{
        new BoxI64(10),
        new BoxI64(11),
        new BoxI64(12),
        new BoxI64(13),
        new BoxI64(14),
        new BoxI64(15),
        new BoxI64(1),
        new BoxI64(6),
        new BoxI64(1),
        new BoxI64(11),
        new BoxI64(9),
        new builtins::WeightedPayload(4, 3),
        new Str(copy "vm"),
        new BoxBool(true),
        new BoxU64(7u),
        new builtins::TogglePayload(6, false)
    };
    return new model::Program(
        "builtin_dispatch",
        0u,
        functions,
        constants,
        extended_builtin_table(),
        4u
    );
}

fn build_builtin_dispatch_case() -> model::BenchmarkCase {
    return model::BenchmarkCase(
        "builtin_dispatch", build_builtin_dispatch_program(),
        267558292, 267558292, 7970829076972, 535116705,
        18u, 0u, 0u, 3u
    );
}

fn build_obj_cast_builtin_program() -> shared model::Program {
    var code: ((shared model::Instruction)?)[] =
        ((shared model::Instruction)?)[](16u);
    code[0] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 0, 0u);
    code[1] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 1, 1u);
    code[2] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 2, 2u);
    code[3] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 3, 3u);
    code[4] = new instructions::CallBuiltinOp(
        opcodes::call_builtin_opcode(), 1u, 4u
    );
    code[5] = new instructions::RegisterCopyOp(opcodes::move_opcode(), 4, 0);
    code[6] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 0, 4u);
    code[7] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 1, 5u);
    code[8] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 2, 6u);
    code[9] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 3, 7u);
    code[10] = new instructions::CallBuiltinOp(
        opcodes::call_builtin_opcode(), 2u, 4u
    );
    code[11] = new instructions::AddOp(opcodes::add_opcode(), 5, 4, 0);
    code[12] = new instructions::StoreMemOp(opcodes::store_mem_opcode(), 0, 5);
    code[13] = new instructions::RegisterCopyOp(opcodes::move_opcode(), 0, 5);
    code[14] = new instructions::CallBuiltinOp(
        opcodes::call_builtin_opcode(), 0u, 1u
    );
    code[15] = new instructions::HaltOp(opcodes::halt_opcode(), 5);

    var functions: model::FunctionInfo[] = model::FunctionInfo[]{
        model::FunctionInfo("main", 0u, 6u, code)
    };
    var constants: (shared Obj)[] = (shared Obj)[]{
        new BoxI64(10),
        new BoxI64(11),
        new BoxI64(12),
        new BoxI64(13),
        new BoxI64(2),
        new BoxI64(9),
        new BoxI64(2),
        new BoxI64(14),
        new BoxI64(0),
        new BoxI64(0),
        new BoxU64(12u),
        new Str(copy "cast"),
        new builtins::TogglePayload(5, true),
        new BoxBool(false),
        new builtins::WeightedPayload(2, 4)
    };
    return new model::Program(
        "obj_cast_builtin",
        0u,
        functions,
        constants,
        extended_builtin_table(),
        4u
    );
}

fn build_obj_cast_builtin_case() -> model::BenchmarkCase {
    return model::BenchmarkCase(
        "obj_cast_builtin", build_obj_cast_builtin_program(),
        400635, 400635, 11935317285, 801391,
        16u, 0u, 0u, 3u
    );
}

fn build_exact_double_program() -> shared model::Program {
    var code: ((shared model::Instruction)?)[] =
        ((shared model::Instruction)?)[](8u);
    code[0] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 0, 0u);
    code[1] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 1, 1u);
    code[2] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 2, 2u);
    code[3] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 3, 3u);
    code[4] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 4, 4u);
    code[5] = new instructions::CallBuiltinOp(
        opcodes::call_builtin_opcode(), 3u, 5u
    );
    code[6] = new instructions::StoreMemOp(opcodes::store_mem_opcode(), 0, 0);
    code[7] = new instructions::HaltOp(opcodes::halt_opcode(), 0);

    var functions: model::FunctionInfo[] = model::FunctionInfo[]{
        model::FunctionInfo("main", 0u, 5u, code)
    };
    var constants: (shared Obj)[] = (shared Obj)[]{
        new BoxI64(5),
        new BoxI64(6),
        new BoxI64(7),
        new BoxI64(8),
        new BoxI64(4),
        new BoxF64(0.5),
        new BoxF64(1.25),
        new BoxF64(2.0),
        new BoxF64(8.0)
    };
    var builtin_table: (shared model::Builtin)[] =
        (shared model::Builtin)[]{
            new builtins::TraceAccumulatorBuiltin("trace_accumulate"),
            new builtins::ConstPoolMixBuiltin("const_pool_mix"),
            new builtins::RangeFoldBuiltin("range_fold"),
            new builtins::ExactDoubleBuiltin("exact_double")
        };
    return new model::Program(
        "exact_double", 0u, functions, constants, builtin_table, 1u
    );
}

fn build_exact_double_case() -> model::BenchmarkCase {
    return model::BenchmarkCase(
        "exact_double", build_exact_double_program(),
        33, 33, 33, 33, 8u, 0u, 0u, 1u
    );
}

fn build_prime_sum_100_program() -> shared model::Program {
    // Trial-divide every candidate below 100 and accumulate the primes.
    var code: ((shared model::Instruction)?)[] =
        ((shared model::Instruction)?)[](27u);
    code[0] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 0, 0u);
    code[1] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 1, 1u);
    code[2] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 2, 2u);
    code[3] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 4, 3u);
    code[4] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 9, 2u);
    code[5] = new instructions::CmpLtOp(opcodes::cmp_lt_opcode(), 7, 0, 1);
    code[6] = new instructions::JumpIfFalseOp(opcodes::jump_if_false_opcode(), 7, 23u);
    code[7] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 6, 3u);
    code[8] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 3, 0u);
    code[9] = new instructions::CmpLtOp(opcodes::cmp_lt_opcode(), 7, 3, 0);
    code[10] = new instructions::JumpIfFalseOp(opcodes::jump_if_false_opcode(), 7, 18u);
    code[11] = new instructions::ModOp(opcodes::mod_opcode(), 8, 0, 3);
    code[12] = new instructions::CmpEqOp(opcodes::cmp_eq_opcode(), 7, 8, 9);
    code[13] = new instructions::JumpIfFalseOp(opcodes::jump_if_false_opcode(), 7, 16u);
    code[14] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 6, 2u);
    code[15] = new instructions::JumpOp(opcodes::jump_opcode(), 18u);
    code[16] = new instructions::AddOp(opcodes::add_opcode(), 3, 3, 4);
    code[17] = new instructions::JumpOp(opcodes::jump_opcode(), 9u);
    code[18] = new instructions::CmpEqOp(opcodes::cmp_eq_opcode(), 7, 6, 4);
    code[19] = new instructions::JumpIfFalseOp(opcodes::jump_if_false_opcode(), 7, 21u);
    code[20] = new instructions::AddOp(opcodes::add_opcode(), 2, 2, 0);
    code[21] = new instructions::AddOp(opcodes::add_opcode(), 0, 0, 4);
    code[22] = new instructions::JumpOp(opcodes::jump_opcode(), 5u);
    code[23] = new instructions::StoreMemOp(opcodes::store_mem_opcode(), 0, 2);
    code[24] = new instructions::RegisterCopyOp(opcodes::move_opcode(), 0, 2);
    code[25] = new instructions::CallBuiltinOp(opcodes::call_builtin_opcode(), 0u, 1u);
    code[26] = new instructions::HaltOp(opcodes::halt_opcode(), 2);

    var functions: model::FunctionInfo[] = model::FunctionInfo[]{
        model::FunctionInfo("main", 0u, 10u, code)
    };
    var constants: (shared Obj)[] = (shared Obj)[]{
        new BoxI64(2), new BoxI64(100), new BoxI64(0), new BoxI64(1)
    };
    var builtin_table: (shared model::Builtin)[] = (shared model::Builtin)[]{
        new builtins::TraceAccumulatorBuiltin("trace_accumulate")
    };
    return new model::Program(
        "prime_sum_100", 0u, functions, constants, builtin_table, 2u
    );
}

fn build_prime_sum_100_case() -> model::BenchmarkCase {
    return model::BenchmarkCase(
        "prime_sum_100", build_prime_sum_100_program(),
        1060, 1060, 32860, 1181, 8794u, 0u, 2388u, 1u
    );
}

fn build_fibonacci_recursive_program() -> shared model::Program {
    var main_code: ((shared model::Instruction)?)[] =
        ((shared model::Instruction)?)[](6u);
    main_code[0] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 0, 0u);
    main_code[1] = new instructions::CallOp(opcodes::call_opcode(), 1u, 1u, 1);
    main_code[2] = new instructions::StoreMemOp(opcodes::store_mem_opcode(), 0, 1);
    main_code[3] = new instructions::RegisterCopyOp(opcodes::move_opcode(), 0, 1);
    main_code[4] = new instructions::CallBuiltinOp(opcodes::call_builtin_opcode(), 0u, 1u);
    main_code[5] = new instructions::HaltOp(opcodes::halt_opcode(), 1);

    // The guest function recursively computes fib(15), exercising frame restore.
    var fib_code: ((shared model::Instruction)?)[] =
        ((shared model::Instruction)?)[](12u);
    fib_code[0] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 1, 1u);
    fib_code[1] = new instructions::LoadConstOp(opcodes::load_const_opcode(), 2, 2u);
    fib_code[2] = new instructions::CmpLtOp(opcodes::cmp_lt_opcode(), 3, 0, 2);
    fib_code[3] = new instructions::JumpIfTrueOp(opcodes::jump_if_true_opcode(), 3, 11u);
    fib_code[4] = new instructions::RegisterCopyOp(opcodes::move_opcode(), 4, 0);
    fib_code[5] = new instructions::SubOp(opcodes::sub_opcode(), 0, 0, 1);
    fib_code[6] = new instructions::CallOp(opcodes::call_opcode(), 1u, 1u, 5);
    fib_code[7] = new instructions::SubOp(opcodes::sub_opcode(), 0, 4, 2);
    fib_code[8] = new instructions::CallOp(opcodes::call_opcode(), 1u, 1u, 6);
    fib_code[9] = new instructions::AddOp(opcodes::add_opcode(), 7, 5, 6);
    fib_code[10] = new instructions::RetOp(opcodes::ret_opcode(), 7);
    fib_code[11] = new instructions::RetOp(opcodes::ret_opcode(), 0);

    var functions: model::FunctionInfo[] = model::FunctionInfo[]{
        model::FunctionInfo("main", 0u, 2u, main_code),
        model::FunctionInfo("fib", 1u, 8u, fib_code)
    };
    var constants: (shared Obj)[] = (shared Obj)[]{
        new BoxI64(15), new BoxI64(1), new BoxI64(2)
    };
    var builtin_table: (shared model::Builtin)[] = (shared model::Builtin)[]{
        new builtins::TraceAccumulatorBuiltin("trace_accumulate")
    };
    return new model::Program(
        "fibonacci_recursive", 0u, functions, constants, builtin_table, 2u
    );
}

fn build_fibonacci_recursive_case() -> model::BenchmarkCase {
    return model::BenchmarkCase(
        "fibonacci_recursive", build_fibonacci_recursive_program(),
        610, 610, 18910, 731, 15787u, 1973u, 987u, 1u
    );
}

fn emit_instruction(
    mut ref code: ((shared model::Instruction)?)[],
    pc: i64,
    instruction: shared model::Instruction
) -> i64 {
    code[pc] = instruction;
    return pc + 1;
}

fn build_sha1_quick_brown_fox_program() -> shared model::Program {
    // Build the large guest stream sequentially, retaining patchable branches.
    var code: ((shared model::Instruction)?)[] =
        ((shared model::Instruction)?)[](512u);
    var pc: i64 = 0;

    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 0, 0u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 2, 1u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 3, 2u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 4, 3u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 5, 4u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 6, 5u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 7, 6u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 8, 7u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 9, 8u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 10, 9u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 11, 10u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 12, 11u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 13, 12u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 14, 13u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 20, 14u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 21, 15u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 22, 16u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 23, 17u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 24, 18u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 25, 19u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 26, 20u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 27, 21u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 28, 22u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 29, 23u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 30, 24u));
    pc = emit_instruction(code, pc, new instructions::LoadConstOp(opcodes::load_const_opcode(), 31, 25u));

    // Seed W[0..15] with the padded message block.
    for (word_slot in 0 .. 16) {
        pc = emit_instruction(code, pc, new instructions::LoadConstOp(
            opcodes::load_const_opcode(), 34, (u64) (26 + word_slot)
        ));
        pc = emit_instruction(code, pc, new instructions::StoreMemOp(
            opcodes::store_mem_opcode(), word_slot, 34
        ));
    }

    // Expand W[16..79] with SHA-1's rotate-left-by-one recurrence.
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 1, 8));
    var schedule_loop_start: i64 = pc;
    pc = emit_instruction(code, pc, new instructions::CmpLtOp(opcodes::cmp_lt_opcode(), 39, 1, 21));
    var schedule_exit_jump_pc: i64 = pc;
    pc = emit_instruction(code, pc, new instructions::JumpIfFalseOp(opcodes::jump_if_false_opcode(), 39, 0u));
    pc = emit_instruction(code, pc, new instructions::SubOp(opcodes::sub_opcode(), 35, 1, 4));
    pc = emit_instruction(code, pc, new instructions::LoadMemIndexedOp(opcodes::load_mem_indexed_opcode(), 35, 0, 35));
    pc = emit_instruction(code, pc, new instructions::SubOp(opcodes::sub_opcode(), 36, 1, 6));
    pc = emit_instruction(code, pc, new instructions::LoadMemIndexedOp(opcodes::load_mem_indexed_opcode(), 36, 0, 36));
    pc = emit_instruction(code, pc, new instructions::SubOp(opcodes::sub_opcode(), 37, 1, 7));
    pc = emit_instruction(code, pc, new instructions::LoadMemIndexedOp(opcodes::load_mem_indexed_opcode(), 37, 0, 37));
    pc = emit_instruction(code, pc, new instructions::SubOp(opcodes::sub_opcode(), 38, 1, 8));
    pc = emit_instruction(code, pc, new instructions::LoadMemIndexedOp(opcodes::load_mem_indexed_opcode(), 38, 0, 38));
    pc = emit_instruction(code, pc, new instructions::XorOp(opcodes::xor_opcode(), 35, 35, 36));
    pc = emit_instruction(code, pc, new instructions::XorOp(opcodes::xor_opcode(), 35, 35, 37));
    pc = emit_instruction(code, pc, new instructions::XorOp(opcodes::xor_opcode(), 35, 35, 38));
    pc = emit_instruction(code, pc, new instructions::ShlOp(opcodes::shl_opcode(), 36, 35, 2));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 36, 36, 22));
    pc = emit_instruction(code, pc, new instructions::ShrOp(opcodes::shr_opcode(), 37, 35, 12));
    pc = emit_instruction(code, pc, new instructions::OrOp(opcodes::or_opcode(), 35, 36, 37));
    pc = emit_instruction(code, pc, new instructions::StoreMemIndexedOp(opcodes::store_mem_indexed_opcode(), 35, 0, 1));
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 1, 1, 2));
    pc = emit_instruction(code, pc, new instructions::JumpOp(opcodes::jump_opcode(), (u64) schedule_loop_start));
    code[schedule_exit_jump_pc] = new instructions::JumpIfFalseOp(
        opcodes::jump_if_false_opcode(), 39, (u64) pc
    );

    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 15, 27));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 16, 28));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 17, 29));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 18, 30));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 19, 31));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 1, 0));

    // Execute the four SHA-1 round functions, patching their forward exits.
    var round_loop_start: i64 = pc;
    pc = emit_instruction(code, pc, new instructions::CmpLtOp(opcodes::cmp_lt_opcode(), 39, 1, 21));
    var round_exit_jump_pc: i64 = pc;
    pc = emit_instruction(code, pc, new instructions::JumpIfFalseOp(opcodes::jump_if_false_opcode(), 39, 0u));
    pc = emit_instruction(code, pc, new instructions::LoadMemIndexedOp(opcodes::load_mem_indexed_opcode(), 34, 0, 1));
    pc = emit_instruction(code, pc, new instructions::CmpLtOp(opcodes::cmp_lt_opcode(), 39, 1, 9));
    var choose_jump_pc: i64 = pc;
    pc = emit_instruction(code, pc, new instructions::JumpIfFalseOp(opcodes::jump_if_false_opcode(), 39, 0u));
    pc = emit_instruction(code, pc, new instructions::XorOp(opcodes::xor_opcode(), 35, 17, 18));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 35, 16, 35));
    pc = emit_instruction(code, pc, new instructions::XorOp(opcodes::xor_opcode(), 32, 18, 35));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 33, 23));
    var fn_done_after_choose_jump_pc: i64 = pc;
    pc = emit_instruction(code, pc, new instructions::JumpOp(opcodes::jump_opcode(), 0u));

    var parity_one_start: i64 = pc;
    code[choose_jump_pc] = new instructions::JumpIfFalseOp(
        opcodes::jump_if_false_opcode(), 39, (u64) parity_one_start
    );
    pc = emit_instruction(code, pc, new instructions::CmpLtOp(opcodes::cmp_lt_opcode(), 39, 1, 14));
    var parity_one_jump_pc: i64 = pc;
    pc = emit_instruction(code, pc, new instructions::JumpIfFalseOp(opcodes::jump_if_false_opcode(), 39, 0u));
    pc = emit_instruction(code, pc, new instructions::XorOp(opcodes::xor_opcode(), 32, 16, 17));
    pc = emit_instruction(code, pc, new instructions::XorOp(opcodes::xor_opcode(), 32, 32, 18));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 33, 24));
    var fn_done_after_parity_one_jump_pc: i64 = pc;
    pc = emit_instruction(code, pc, new instructions::JumpOp(opcodes::jump_opcode(), 0u));

    var majority_start: i64 = pc;
    code[parity_one_jump_pc] = new instructions::JumpIfFalseOp(
        opcodes::jump_if_false_opcode(), 39, (u64) majority_start
    );
    pc = emit_instruction(code, pc, new instructions::CmpLtOp(opcodes::cmp_lt_opcode(), 39, 1, 20));
    var majority_jump_pc: i64 = pc;
    pc = emit_instruction(code, pc, new instructions::JumpIfFalseOp(opcodes::jump_if_false_opcode(), 39, 0u));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 35, 16, 17));
    pc = emit_instruction(code, pc, new instructions::OrOp(opcodes::or_opcode(), 36, 16, 17));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 36, 18, 36));
    pc = emit_instruction(code, pc, new instructions::OrOp(opcodes::or_opcode(), 32, 35, 36));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 33, 25));
    var fn_done_after_majority_jump_pc: i64 = pc;
    pc = emit_instruction(code, pc, new instructions::JumpOp(opcodes::jump_opcode(), 0u));

    var parity_two_start: i64 = pc;
    code[majority_jump_pc] = new instructions::JumpIfFalseOp(
        opcodes::jump_if_false_opcode(), 39, (u64) parity_two_start
    );
    pc = emit_instruction(code, pc, new instructions::XorOp(opcodes::xor_opcode(), 32, 16, 17));
    pc = emit_instruction(code, pc, new instructions::XorOp(opcodes::xor_opcode(), 32, 32, 18));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 33, 26));

    var fn_done_start: i64 = pc;
    code[fn_done_after_choose_jump_pc] = new instructions::JumpOp(
        opcodes::jump_opcode(), (u64) fn_done_start
    );
    code[fn_done_after_parity_one_jump_pc] = new instructions::JumpOp(
        opcodes::jump_opcode(), (u64) fn_done_start
    );
    code[fn_done_after_majority_jump_pc] = new instructions::JumpOp(
        opcodes::jump_opcode(), (u64) fn_done_start
    );

    pc = emit_instruction(code, pc, new instructions::ShlOp(opcodes::shl_opcode(), 35, 15, 5));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 35, 35, 22));
    pc = emit_instruction(code, pc, new instructions::ShrOp(opcodes::shr_opcode(), 36, 15, 10));
    pc = emit_instruction(code, pc, new instructions::OrOp(opcodes::or_opcode(), 35, 35, 36));
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 35, 35, 32));
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 35, 35, 19));
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 35, 35, 33));
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 35, 35, 34));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 35, 35, 22));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 19, 18));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 18, 17));
    pc = emit_instruction(code, pc, new instructions::ShlOp(opcodes::shl_opcode(), 36, 16, 11));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 36, 36, 22));
    pc = emit_instruction(code, pc, new instructions::ShrOp(opcodes::shr_opcode(), 37, 16, 3));
    pc = emit_instruction(code, pc, new instructions::OrOp(opcodes::or_opcode(), 17, 36, 37));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 17, 17, 22));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 16, 15));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 15, 35));
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 1, 1, 2));
    pc = emit_instruction(code, pc, new instructions::JumpOp(opcodes::jump_opcode(), (u64) round_loop_start));
    code[round_exit_jump_pc] = new instructions::JumpIfFalseOp(
        opcodes::jump_if_false_opcode(), 39, (u64) pc
    );

    // Add the working words back into the digest and reconstruct its high 64 bits.
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 27, 27, 15));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 27, 27, 22));
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 28, 28, 16));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 28, 28, 22));
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 29, 29, 17));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 29, 29, 22));
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 30, 30, 18));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 30, 30, 22));
    pc = emit_instruction(code, pc, new instructions::AddOp(opcodes::add_opcode(), 31, 31, 19));
    pc = emit_instruction(code, pc, new instructions::AndOp(opcodes::and_opcode(), 31, 31, 22));
    pc = emit_instruction(code, pc, new instructions::StoreMemOp(opcodes::store_mem_opcode(), 0, 27));
    pc = emit_instruction(code, pc, new instructions::StoreMemOp(opcodes::store_mem_opcode(), 1, 28));
    pc = emit_instruction(code, pc, new instructions::StoreMemOp(opcodes::store_mem_opcode(), 2, 29));
    pc = emit_instruction(code, pc, new instructions::StoreMemOp(opcodes::store_mem_opcode(), 3, 30));
    pc = emit_instruction(code, pc, new instructions::StoreMemOp(opcodes::store_mem_opcode(), 4, 31));
    pc = emit_instruction(code, pc, new instructions::ShlOp(opcodes::shl_opcode(), 40, 27, 13));
    pc = emit_instruction(code, pc, new instructions::OrOp(opcodes::or_opcode(), 40, 40, 28));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 0, 27));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 1, 28));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 2, 29));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 3, 30));
    pc = emit_instruction(code, pc, new instructions::RegisterCopyOp(opcodes::move_opcode(), 4, 31));
    pc = emit_instruction(code, pc, new instructions::CallBuiltinOp(opcodes::call_builtin_opcode(), 0u, 5u));
    pc = emit_instruction(code, pc, new instructions::HaltOp(opcodes::halt_opcode(), 40));

    var functions: model::FunctionInfo[] = model::FunctionInfo[]{
        model::FunctionInfo("main", 0u, 41u, code[:pc])
    };
    // All SHA words are represented as non-negative i64 values and masked to
    // 32 bits; guest shift counts are fixed in-range register values.
    var constants: (shared Obj)[] = (shared Obj)[]{
        new BoxI64(0), new BoxI64(1), new BoxI64(2), new BoxI64(3),
        new BoxI64(5), new BoxI64(8), new BoxI64(14), new BoxI64(16),
        new BoxI64(20), new BoxI64(27), new BoxI64(30), new BoxI64(31),
        new BoxI64(32), new BoxI64(40), new BoxI64(60), new BoxI64(80),
        new BoxI64(4294967295), new BoxI64(1518500249),
        new BoxI64(1859775393), new BoxI64(2400959708),
        new BoxI64(3395469782), new BoxI64(1732584193),
        new BoxI64(4023233417), new BoxI64(2562383102),
        new BoxI64(271733878), new BoxI64(3285377520),
        new BoxI64(1416127776), new BoxI64(1903520099),
        new BoxI64(1797284466), new BoxI64(1870097952),
        new BoxI64(1718581280), new BoxI64(1786080624),
        new BoxI64(1931505526), new BoxI64(1701978228),
        new BoxI64(1751457900), new BoxI64(1635416352),
        new BoxI64(1685022592), new BoxI64(0), new BoxI64(0),
        new BoxI64(0), new BoxI64(0), new BoxI64(344)
    };
    var builtin_table: (shared model::Builtin)[] = (shared model::Builtin)[]{
        new builtins::TraceAccumulatorBuiltin("trace_accumulate")
    };
    return new model::Program(
        "sha1_quick_brown_fox", 0u, functions, constants, builtin_table, 80u
    );
}

fn build_sha1_quick_brown_fox_case() -> model::BenchmarkCase {
    // Reproduce independently with:
    // printf '%s' 'The quick brown fox jumps over the lazy dog' | sha1sum -> 2fd4e1c67a2d28fced849ee1bb76e7391b93eb12
    // The first 16 hex digits form the return value; the first 8 form memory0.
    return model::BenchmarkCase(
        "sha1_quick_brown_fox", build_sha1_quick_brown_fox_program(),
        0x2fd4e1c67a2d28fc, 0x2fd4e1c6, -1257569273529833621,
        10444962923, 3933u, 0u, 326u, 1u
    );
}

public fn build_cases() -> model::BenchmarkCase[] {
    return model::BenchmarkCase[]{
        build_minimal_case(),
        build_arithmetic_case(),
        build_branch_maze_case(),
        build_recursive_case(),
        build_dense_array_case(),
        build_slice_copy_case(),
        build_builtin_dispatch_case(),
        build_obj_cast_builtin_case(),
        build_exact_double_case(),
        build_prime_sum_100_case(),
        build_fibonacci_recursive_case(),
        build_sha1_quick_brown_fox_case()
    };
}
