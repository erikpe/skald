import std::process;
import std::str;
from std::test import assert_eq_str, assert_eq_u64, assert_true;

fn check_exact_bytes(ref values: std::str::Str[]) -> unit {
    assert_eq_u64(values.len(), 5u);
    assert_true(values[0].len() > 0u);
    assert_eq_str(values[1], "plain");
    assert_eq_str(values[2], "space arg\tline\n");
    assert_eq_u64(values[3].len(), 0u);
    assert_eq_str(values[4], "raw\xffbytes");
}

fn main() -> i64 {
    var values: std::str::Str[] = std::process::args();
    if (values.len() == 1u) {
        var second: std::str::Str[] = std::process::args();
        assert_eq_u64(second.len(), 1u);
        assert_true(values[0].len() > 0u);
        assert_true(second[0].len() > 0u);

        values[0] = "";
        assert_true(second[0].len() > 0u);
        return 0;
    }
    check_exact_bytes(values);
    return 0;
}
