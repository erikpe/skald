import std::io;

fn announce(value: i64) -> i64 {
    std::io::println_i64(value);
    return value;
}

class Resource {
    marker: i64;
    ready: bool;

    init(marker: i64) {
        self.marker = marker;
        self.ready = (marker > 0) && (false || true);
    }

    fn allows(marker: i64) -> bool {
        return self.ready && (self.marker == marker) && (true || dead_target());
    }

    destroy {
        if (self.ready && (self.marker > 0) && true) {
            std::io::println_i64(self.marker);
        }
    }
}

class State {
    static ready: bool = true && (false || true);
    static marker: i64 = announce(10);
    static resource: Resource = Resource(20);

    init() {}
}

fn dead_target() -> bool {
    std::io::println_i64(-1);
    return true;
}

fn proof_dead_region() -> i64 {
    if (true) {
        return 1;
    }
    if (false && dead_target()) {
        return 2;
    }
    return 3;
}

fn positive(value: i64) -> bool {
    return value > 0;
}

fn main() -> i64 {
    var predicate: fn(i64) -> bool = positive;
    var maybe: i64? = some(5);
    var values: i64[] = i64[]{7};
    var owner: shared Resource = new Resource(30);
    var index: i64 = 0;
    var total: i64 = 0;

    std::io::println_i64(proof_dead_region());
    while ((index < 2) && (true || dead_target())) {
        total = total + 1;
        index = index + 1;
    }
    std::io::println_i64(total);
    if (false && predicate(total)) {
        return 1;
    } elif (predicate(total) && State.ready && owner->allows(30) && ((maybe is some) || dead_target())) {
        std::io::println_i64(maybe!);
        std::io::println_i64(values[0]);
        std::io::println_i64(owner->marker);
        std::io::println_i64(State.resource.marker);
    }
    if (false && ((values[0] == 7) || dead_target())) {
        return 1;
    }
    return State.marker - 10;
}
