from std::error import panic;

fn dead_target() -> bool {
    panic("unreachable normalization failure");
    return true;
}

fn fail(selected: bool) -> i64 {
    if (selected && (true || dead_target())) {
        panic("reachable normalization failure");
    }
    return 0;
}

fn main() -> i64 {
    return fail(true);
}
