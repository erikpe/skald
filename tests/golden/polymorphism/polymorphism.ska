import std::io;

interface Readable {
    fn read() -> i64;
}

interface Adjustable {
    mut fn add(amount: i64) -> i64;
}

class Root implements Adjustable, Readable {
    value: i64;

    init(value: i64) {
        self.value = value;
    }

    copy(ref other: Root) {
        self.value = other.value + 100;
    }

    virtual fn read() -> i64 {
        return self.value;
    }

    virtual mut fn add(amount: i64) -> i64 {
        self.value = self.value + amount;
        return self.value;
    }

    fn read_through_self() -> i64 {
        return self.read();
    }

    destroy {
        std::io::println_i64(1000 + self.value);
    }
}

class Middle extends Root {
    init(value: i64) {
        super(value);
    }

    destroy {
        std::io::println_i64(2000 + self.value);
    }
}

class Leaf extends Middle {
    extra: i64;

    init(value: i64, extra: i64) {
        super(value);
        self.extra = extra;
    }

    override fn read() -> i64 {
        return self.value + self.extra;
    }

    override mut fn add(amount: i64) -> i64 {
        self.value = self.value + amount + self.extra;
        return self.value;
    }

    destroy {
        std::io::println_i64(3000 + self.extra);
    }
}

fn read_root(ref value: Root) -> i64 {
    return value.read();
}

fn read_interface(ref value: Readable) -> i64 {
    return value.read();
}

fn adjust_interface(mut ref value: Adjustable, amount: i64) -> i64 {
    return value.add(amount);
}

fn classify(ref value: Obj) -> i64 {
    if (value is Leaf) {
        return 1;
    } else {
        return 0;
    }
}

fn classify_interface(ref value: Readable) -> i64 {
    return classify(value);
}

fn cast_read(ref value: Obj) -> i64 {
    return ((Leaf) value).read();
}

fn slice(ref value: Leaf) -> Root {
    return value;
}

fn main() -> i64 {
    var leaf: Leaf = Leaf(10, 5);
    std::io::println_i64(read_root(leaf));
    std::io::println_i64(read_interface(leaf));
    std::io::println_i64(adjust_interface(leaf, 2));
    std::io::println_i64(leaf.read_through_self());
    std::io::println_i64(classify_interface(leaf));
    std::io::println_i64(cast_read(leaf));

    var sliced: Root = slice(leaf);
    std::io::println_i64(read_root(sliced));

    var copied: Leaf = leaf;
    std::io::println_i64(read_root(copied));
    return 0;
}
