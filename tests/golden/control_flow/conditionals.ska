import std::io;

fn first() -> bool {
    std::io::println_i64(1);
    return false;
}

fn second() -> bool {
    std::io::println_i64(2);
    return true;
}

fn third() -> bool {
    std::io::println_i64(3);
    return true;
}

fn classify(outer: bool, inner: bool) -> i64 {
    if (outer) {
        if (inner) {
            return 11;
        }
        else {
            return 12;
        }
    }
    elif (inner) {
        return 21;
    }
    else {
        return 22;
    }
}

fn main() -> i64 {
    if (first()) {
        std::io::println_i64(10);
    }
    elif (second()) {
        std::io::println_i64(20);
    }
    elif (third()) {
        std::io::println_i64(30);
    }
    else {
        std::io::println_i64(40);
    }

    if (false) {
        std::io::println_i64(30);
    }
    else {
        std::io::println_i64(40);
    }

    if (true) {
        std::io::println_i64(50);
    }
    else {
        std::io::println_i64(60);
    }

    if (false) {
        std::io::println_i64(60);
    }
    std::io::println_i64(70);
    std::io::println_i64(classify(true, true));
    std::io::println_i64(classify(true, false));
    std::io::println_i64(classify(false, true));
    std::io::println_i64(classify(false, false));
    return 0;
}
