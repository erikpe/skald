import std::io;
from std::test import assert_eq_i64, assert_false, assert_true;

class Item {
    value: i64;

    init(value: i64) {
        self.value = value;
    }

    fn read() -> i64 {
        return self.value;
    }

    destroy {
        std::io::println_i64(self.value);
    }
}

class State {
    static number: i64;
    static flag: bool;
    static maybe: Item?;
    static owner: shared? Item;

    init() {}
}

fn increment(mut ref value: i64) -> unit {
    value = value + 1;
}

fn main() -> i64 {
    assert_eq_i64(State.number, 0);
    assert_false(State.flag);
    assert_true(State.maybe is none);
    assert_true(State.owner is none);
    State.number = 40;
    increment(State.number);
    State.maybe = Item(7);
    // Replacing the payload destroys 7; the assigned producer cleans its
    // distinct temporary 41 after copying. Reverse normal-return shutdown
    // later destroys the retained static 41.
    State.maybe = Item(41);
    State.owner = new Item(8);
    State.owner = none;
    State.owner = new Item(42);
    // Reverse shutdown releases this final owner before the optional payload.
    State.flag = true;
    assert_true(State.flag);
    assert_eq_i64(State.number, 41);
    assert_true(State.owner is some);
    assert_eq_i64(State.owner!->read(), 42);
    return 0;
}
