class Base {
    init() {}
    virtual fn read() -> i64 {
        return 0;
    }
}

class Child extends Base {
    init() {
        super();
    }

    override fn read() -> i64 {
        return State.result;
    }
}

fn call_read(ref value: Base) -> i64 {
    return value.read();
}

class State {
    static result: i64 = call_read(Base());
    init() {}
}

fn main() -> i64 {
    return State.result;
}
