import std::io;

class Seed {
    init() {}

    destroy {
        std::io::println_i64(10);
    }
}

class Node {
    edge: shared Obj;

    init(edge: shared Obj) {
        self.edge = edge;
    }

    destroy {
        std::io::println_i64(1);
    }
}

fn main() -> i64 {
    {
        var seed: shared Obj = new Seed();
        var left: shared Node = new Node(seed);
        var right: shared Node = new Node(left);
        left->edge = right;
        var control: shared Seed = new Seed();
    }
    return 0;
}
