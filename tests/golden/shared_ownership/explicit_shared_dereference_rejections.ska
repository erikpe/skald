class Leaf {
    init() {}
}

fn done() -> unit {}

fn inspect(ref borrowed: Leaf) -> i64 {
    *borrowed;
    return 0;
}

fn main() -> i64 {
    var number: i64 = 1;
    var inline: Leaf = Leaf();
    var owner: shared Leaf = new Leaf();
    *number;
    inline->missing;
    *done();
    *owner = inline;
    return 0;
}
