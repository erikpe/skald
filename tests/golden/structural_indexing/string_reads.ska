from std::str import Str;
from std::test import assert_eq_str, assert_eq_u8;

interface StringReads {
    fn index_get(index: i64) -> u8;
    fn slice_get(start: i64?, end: i64?) -> Str;
}

class StringView implements StringReads {
    value: Str;

    init(ref value: Str) {
        self.value = value;
    }

    fn index_get(index: i64) -> u8 {
        return self.value[index];
    }

    fn slice_get(start: i64?, end: i64?) -> Str {
        return self.value.slice_get(start, end);
    }
}

fn produced_text() -> Str {
    return "produced";
}

fn retained_slice() -> Str {
    var bytes: u8[] = u8[]{'a', 'b', 'c', 'd', 'e'};
    var source: Str = Str.from_bytes(bytes);
    var result: Str = source[1:-1];

    bytes[1] = 'x';
    source = "replacement";
    return result;
}

fn through_interface(ref value: StringReads) -> Str {
    assert_eq_u8(value[-1], 'e');
    return value[1:-1];
}

fn main() -> i64 {
    assert_eq_u8("skald"[0], 's');
    assert_eq_str("skald"[1:4], "kal");

    var named: Str = "abcde";
    assert_eq_u8(named[-1], named.index_get(-1));
    assert_eq_str(named[:], "abcde");
    assert_eq_str(named[:2], "ab");
    assert_eq_str(named[2:], "cde");
    assert_eq_str(named[1:4], named.slice_get(1, 4));
    assert_eq_str(named[-4:-1], "bcd");
    assert_eq_str(named[2:2], "");
    assert_eq_str(""[:], "");

    var copied: Str = named;
    named = "changed";
    assert_eq_u8(copied[0], 'a');
    assert_eq_str(copied[:], "abcde");

    assert_eq_u8(produced_text()[1], 'r');
    assert_eq_str(produced_text()[2:-1], "oduce");

    var owner: shared Str = new Str(copy copied);
    assert_eq_u8(owner->[-2], 'd');
    assert_eq_str(owner->[1:4], "bcd");

    var view: StringView = StringView(copied);
    assert_eq_str(through_interface(view), "bcd");

    assert_eq_str(retained_slice(), "bcd");
    return 0;
}
