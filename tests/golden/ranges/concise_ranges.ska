import std::io;
from std::ops import OpLess;
from std::range import Range, Successor;

class Value implements OpLess<Value>, Successor<Value> {
    private static _successors: u64;
    private _value: i64;

    init(value: i64) {
        self._value = value;
    }

    fn op_less(ref rhs: Value) -> bool {
        return self._value < rhs._value;
    }

    fn successor() -> Value {
        Value._successors = Value._successors + 1u;
        return Value(self._value + 1);
    }

    fn value() -> i64 {
        return self._value;
    }

    static fn successors() -> u64 {
        return Value._successors;
    }
}

fn traced_lower() -> u64 {
    std::io::println_u64(101u);
    return 2u;
}

fn traced_upper() -> u64 {
    std::io::println_u64(102u);
    return 5u;
}

fn make_range(start: u64, end: u64) -> Range<u64> {
    return Range<u64>(start, end);
}

fn sum(ref values: Range<u64>) -> u64 {
    var total: u64 = 0u;
    for (value in values) {
        total = total + value;
    }
    return total;
}

fn first(start: i64, end: i64) -> i64 {
    for (value in start .. end) {
        return value;
    }
    return -99;
}

fn main() -> i64 {
    for (value in traced_lower() .. traced_upper()) {
        std::io::println_u64(value);
    }

    var stored: Range<u64> = Range<u64>(5u, 8u);
    std::io::println_u64(sum(stored));
    std::io::println_u64(sum(Range<u64>(8u, 11u)));
    std::io::println_u64(sum(make_range(11u, 14u)));

    var exited: u64 = 0u;
    for (value in (0u) .. (6u)) {
        if (value == 1u) {
            continue;
        }
        if (value == 4u) {
            break;
        }
        exited = exited + value;
    }
    std::io::println_u64(exited);

    for (value in 254u8 .. 255u8) {
        std::io::println_u8(value);
    }

    for (value in -2 .. 1) {
        std::io::println_i64(value);
    }
    std::io::println_i64(first(7, 9));
    std::io::println_i64(first(3, 3));
    std::io::println_i64(first(4, 2));

    var nested_total: u64 = 0u;
    var nested_stored: Range<u64> = Range<u64>(1u, 3u);
    for (outer in 0u .. 2u) {
        for (inner in nested_stored) {
            nested_total = nested_total + outer + inner;
        }
    }
    std::io::println_u64(nested_total);

    for (value in 18446744073709551614u .. 18446744073709551615u) {
        std::io::println_u64(value);
    }
    for (value in 9223372036854775806 .. 9223372036854775807) {
        std::io::println_i64(value);
    }

    for (value in Value(1) .. Value(4)) {
        std::io::println_i64(value.value());
        std::io::println_u64(Value.successors());
    }
    return 0;
}
