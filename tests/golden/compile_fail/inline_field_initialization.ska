class Child {
    value: i64;
    init(value: i64) {
        self.value = value;
    }
    fn get() -> i64 {
        return self.value;
    }
}

class Other {
    init() {}
}

class Parent {
    wrong: Child;
    grouped: Child;
    child: Child;
    first: i64;
    missing: i64;

    init() {
        self.wrong = Other();
        self.grouped = (Child(1));
        self.first = self.child.get();
        self.child = Child(2);
        self.child = Child(3);
    }
}

fn main() -> i64 {
    return 0;
}
