fn take_u64(value: u64) -> unit {}

fn implicit_integer_to_float() -> f64 {
    return 1;
}

fn implicit_float_to_integer() -> i64 {
    return 1.0;
}

fn mixed_arithmetic() -> f64 {
    return 1.0 + 1;
}

fn negate_u64() -> u64 {
    return -1u;
}

fn negate_u8() -> u8 {
    return -1u8;
}

fn main() -> i64 {
    take_u64(1);
    return 0;
}
