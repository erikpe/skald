fn main() -> i64 {
    var signed: i64? = 40;
    var unsigned: u64? = 7u;
    var byte: u8? = 8u8;
    var float: f64? = 1.5;
    var flag: bool? = true;

    var signed_value: i64 = signed!;
    var unsigned_value: u64 = unsigned!;
    var byte_value: u8 = byte!;
    var float_value: f64 = float!;
    var flag_value: bool = flag!;

    if (flag_value) {
        if (unsigned is some) {
            if (byte is some) {
                if (float is some) {
                    return signed_value + 2;
                }
            }
        }
    }
    return 0;
}
