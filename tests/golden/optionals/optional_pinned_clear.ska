class Item {
    value: i64;

    init(value: i64) {
        self.value = value;
    }
}

class Holder {
    item: Item?;

    init(item: Item?) {
        self.item = item;
    }

    mut fn clear() -> i64 {
        self.item = none;
        return 0;
    }
}

fn consume(ref item: Item, ignored: i64) -> i64 {
    return item.value + ignored;
}

fn main() -> i64 {
    var holder: Holder = Holder(Item(42));
    return consume(holder.item!, holder.clear());
}
