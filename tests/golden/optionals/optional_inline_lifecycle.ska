import std::io;
from std::test import assert_eq_i64, assert_true;

class Value {
    marker: i64;

    init(marker: i64) {
        self.marker = marker;
    }

    destroy {
        std::io::println_i64(self.marker);
    }
}

class Holder {
    value: Value?;

    init(value: Value?) {
        self.value = value;
    }
}

fn forward(value: Value?) -> Value? {
    return value;
}

fn main() -> i64 {
    var first: Value? = Value(42);
    var second: Value? = first;
    first = none;
    first = forward(Value(42));
    var holder: Holder = Holder(first);
    assert_true(holder.value is some);
    assert_eq_i64(holder.value!.marker, 42);
    return 0;
}
