fn increment(value: i64) -> i64 {
    return value + 1;
}

fn decrement(value: i64) -> i64 {
    return value - 1;
}

fn forward(callback: fn(i64) -> i64) -> fn(i64) -> i64 {
    return callback;
}

fn recursive(value: i64) -> i64 {
    if (value == 0) {
        return 0;
    }
    var next: fn(i64) -> i64 = recursive;
    return next(value - 1) + 1;
}

interface Carrier {
    fn carry(callback: fn(i64) -> i64) -> fn(i64) -> i64;
}

class Base implements Carrier {
    callback: fn(i64) -> i64;

    init(callback: fn(i64) -> i64) {
        self.callback = callback;
    }

    virtual fn carry(callback: fn(i64) -> i64) -> fn(i64) -> i64 {
        return callback;
    }

    fn apply(value: i64) -> i64 {
        return self.callback(value);
    }
}

class Derived extends Base {
    init(callback: fn(i64) -> i64) {
        super(callback);
    }

    override fn carry(callback: fn(i64) -> i64) -> fn(i64) -> i64 {
        return self.callback;
    }
}

class Registry {
    static callback: fn(i64) -> i64 = increment;

    init() {}
}

class Cell<T> {
    static bias: i64 = 0;

    init() {}

    static fn apply(value: i64) -> i64 {
        return value + Cell<T>::bias;
    }
}

class Box<T> {
    value: T;

    init(value: T) {
        self.value = value;
    }

    fn get() -> T {
        return self.value;
    }
}

fn through_virtual(ref carrier: Base, callback: fn(i64) -> i64) -> i64 {
    return carrier.carry(callback)(10);
}

fn through_interface(ref carrier: Carrier, callback: fn(i64) -> i64) -> i64 {
    return carrier.carry(callback)(10);
}

fn main() -> i64 {
    var callback: fn(i64) -> i64 = increment;
    callback = decrement;
    if (callback(10) != 9) { return 1; }

    var carrier: Derived = Derived(increment);
    var copy: Derived = carrier;
    if (copy.apply(10) != 11) { return 2; }
    if (through_virtual(carrier, decrement) != 11) { return 3; }
    if (through_interface(carrier, decrement) != 11) { return 4; }
    if (Registry.callback(10) != 11) { return 5; }
    if (forward(increment)(10) != 11) { return 6; }

    var boxed: Box<fn(i64) -> i64> = Box<fn(i64) -> i64>(increment);
    if (boxed.get()(10) != 11) { return 7; }

    Cell<i64>::bias = 1;
    Cell<bool>::bias = 2;
    var integer_target: fn(i64) -> i64 = Cell<i64>::apply;
    var boolean_target: fn(i64) -> i64 = Cell<bool>::apply;
    if (integer_target(10) != 11) { return 8; }
    if (boolean_target(10) != 12) { return 9; }
    if (recursive(5) != 5) { return 10; }

    return 42;
}
