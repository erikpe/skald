class Factory<T> {
    callback: fn(T) -> T;

    init(callback: fn(T) -> T) {
        self.callback = callback;
    }

    static fn identity(value: T) -> T {
        return value;
    }
}

fn main() -> i64 {
    var first: fn(i64) -> i64 = Factory<i64>::identity;
    var second: fn(bool) -> bool = Factory<bool>::identity;
    if (second(true)) {
        return first(42);
    }
    return 1;
}
