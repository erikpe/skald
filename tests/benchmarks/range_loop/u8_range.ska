fn main() -> i64 {
    var checksum: u64 = 0u;
    var repetition: u64 = 0u;
    while (repetition < 100000u) {
        for (item in 0u8 .. 250u8) {
            checksum = checksum + (u64) item;
        }
        repetition = repetition + 1u;
    }
    if (checksum != 3112500000u) {
        return 1;
    }
    return 0;
}
